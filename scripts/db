#!/usr/bin/env bash
# scripts/db — run SQL against the Supabase project via the exec_sql RPC.
#
# Usage:
#   ./scripts/db "select count(*) from sms_subscribers"
#   ./scripts/db < query.sql
#   echo "select 1" | ./scripts/db
#
# Reads SUPABASE_URL and SUPABASE_SERVICE_KEY from hilma/.env.local.
# Uses the service-role key (bypasses RLS) — be careful with mutations.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$REPO_ROOT/.env.local"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: $ENV_FILE not found" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

: "${SUPABASE_URL:?SUPABASE_URL not set in .env.local}"
: "${SUPABASE_SERVICE_KEY:?SUPABASE_SERVICE_KEY not set in .env.local}"

if [[ $# -gt 0 ]]; then
  QUERY="$*"
elif [[ ! -t 0 ]]; then
  QUERY="$(cat)"
else
  echo "usage: db \"SELECT ...\"   |   db < query.sql   |   echo '...' | db" >&2
  exit 1
fi

if [[ -z "${QUERY// /}" ]]; then
  echo "error: empty query" >&2
  exit 1
fi

PAYLOAD="$(jq -n --arg q "$QUERY" '{query: $q}')"

RESPONSE="$(curl -sS -X POST \
  -H "apikey: $SUPABASE_SERVICE_KEY" \
  -H "Authorization: Bearer $SUPABASE_SERVICE_KEY" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD" \
  "$SUPABASE_URL/rest/v1/rpc/exec_sql")"

# Successful queries return a JSON array of rows. Postgres errors come
# back as a JSON object with `code` + `message`. Anything else is raw.
if echo "$RESPONSE" | jq -e 'type == "array"' >/dev/null 2>&1; then
  echo "$RESPONSE" | jq .
elif echo "$RESPONSE" | jq -e 'type == "object" and has("message")' >/dev/null 2>&1; then
  echo "$RESPONSE" | jq . >&2
  exit 1
else
  echo "$RESPONSE"
  exit 1
fi
