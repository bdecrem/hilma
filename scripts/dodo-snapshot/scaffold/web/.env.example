# ── Required ────────────────────────────────────────────────────────────────
# Supabase project (Settings → API). The service key bypasses RLS — server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Anthropic — powers the tutor, quiz grading, card generation.
ANTHROPIC_API_KEY=

# Signs the session cookie. Any long random string (e.g. `openssl rand -hex 32`).
F2_SESSION_SECRET=

# ── Voice + audio (optional — voice rounds, walking tutor, audio summaries) ─
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_REALTIME_REASONING_EFFORT=low
# OPENAI_TTS_VOICE=nova

# ── YouTube ingestion (optional — improves transcript + metadata fetching) ──
YOUTUBE_API_KEY=
# Remote transcript-fetch helper for hosts that block datacenter IPs;
# any endpoint returning {"transcript": "..."} for ?v=<id>.
F2_YOUTUBE_FETCH_URL=
F2_YOUTUBE_FETCH_SECRET=

# ── iMessage daily card (optional — needs a Mac; see README) ────────────────
# BlueBubbles server on the Mac (inbound webhook + default send path).
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=
# Preferred HTTP send agent (BlueBubbles AppleScript sends hang on new macOS).
F2_IMESSAGE_SEND_URL=
F2_IMESSAGE_SEND_SECRET=
# Shared secret your daily cron sends to /api/f2/daily-card.
CRON_SECRET=

# ── Extra chat models (optional — the in-app model picker) ──────────────────
TOGETHER_API_KEY=
