<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>sh.venture.runner</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string>
    <string>unset ANTHROPIC_API_KEY; cd $HOME/hilma-venture &amp;&amp; exec /opt/homebrew/bin/node scripts/venture/runner.mjs tick</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/admin</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/admin/Library/Logs/venture-runner/runner.log</string>
  <key>StandardErrorPath</key><string>/Users/admin/Library/Logs/venture-runner/runner.log</string>
</dict></plist>
