<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- On the Mac mini, always running: writes Kit's voice replies on the Claude login saved for the
     runner (CLAUDE_CODE_OAUTH_TOKEN in ~/.venture-runner.env), never the API key
     (scripts/venture/voice-server.ts, OLA-187). Listens on 127.0.0.1:3931; Vercel reaches it
     through the tunnel in sh.tunn3l.kit-voice.plist with VENTURE_VOICE_SECRET (same file).
     Install both: cp to ~/Library/LaunchAgents/ and launchctl bootstrap gui/501 <plist>. -->
<plist version="1.0"><dict>
  <key>Label</key><string>sh.venture.voice</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string>
    <string>set -a; . $HOME/.venture-runner.env; set +a; unset ANTHROPIC_API_KEY; cd $HOME/hilma-venture &amp;&amp; exec /opt/homebrew/bin/node node_modules/tsx/dist/cli.mjs scripts/venture/voice-server.ts</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>/Users/admin</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/admin/Library/Logs/venture-runner/voice.log</string>
  <key>StandardErrorPath</key><string>/Users/admin/Library/Logs/venture-runner/voice.log</string>
</dict></plist>
