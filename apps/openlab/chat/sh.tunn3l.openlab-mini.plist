<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>sh.tunn3l.openlab-mini</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/admin/.tunn3l/bin/tunn3l</string>
        <string>http</string>
        <string>11440</string>
        <string>--subdomain</string>
        <string>openlab-mini</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/admin</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>StandardOutPath</key><string>/Users/admin/Library/Logs/tunn3l/tunnel-openlab-mini.out.log</string>
    <key>StandardErrorPath</key><string>/Users/admin/Library/Logs/tunn3l/tunnel-openlab-mini.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key><string>/Users/admin</string>
        <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
