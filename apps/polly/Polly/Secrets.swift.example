import Foundation

// Copy this file to Secrets.swift and customize. Secrets.swift is gitignored.
// Use .dev for a local/tunnel backend reachable from the iPhone.

enum Secrets {
    enum Environment {
        case dev
        case production
    }

    static let environment: Environment = .production
    static let devURL = URL(string: "https://bart-imac.tunn3l.sh")!

    static var backendBaseURL: URL {
        switch environment {
        case .dev:
            return devURL
        case .production:
            return URL(string: "https://feynd.cc")!
        }
    }
}
