<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- For the opencode programs in Contents/Helpers under the hardened runtime (the signed download
	     only; testflight/ship-via-mini.sh). opencode is a Bun program: its JavaScript engine compiles
	     code as it runs and loads the terminal and pty libraries it unpacks, which the hardened
	     runtime refuses without these. Bun's own list for signing a compiled program. -->
	<key>com.apple.security.cs.allow-jit</key><true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
	<key>com.apple.security.cs.disable-executable-page-protection</key><true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
