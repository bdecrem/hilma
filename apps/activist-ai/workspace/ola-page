#!/usr/bin/env python3
"""ola-page: look at a page the way a visitor's browser shows it, inside the sealed computer.

    ola-page index.html [--width 390] [--height 900] --out shot.png [--json checks.json] [--viewport] [--dark] [--scale 2]
    ola-page index.html --out .shots/try.png --do "fill 1=Buy milk" --do "fill 2=2026-12-01" --do "click Add" --text

--do tries the page the way a person would, after it loads and before it is measured and pictured:
`fill <n or words>=<value>` types into the n-th visible field (or the one whose label, placeholder or
name has those words), `click <words>` presses the button or link with those words (`click css:<selector>`
for anything else, such as a tile), `press Enter` presses Enter in the last field filled. Steps run in
order, at once (what a click starts with a timer is seen with a longer --wait on the next look); each
prints whether it worked. --text prints the words on the page after the steps, so a result can be read.

Serves the page's own folder on 127.0.0.1 (so the page's fetch() of its data files works, as it does
under Open), loads it in a headless Chromium (chromium-headless-shell from Debian, driven over a
pipe, no network: the computer has none), saves a full-page screenshot, and measures what a program
can measure: horizontal scroll, elements that run past the right edge, clipped text, text below the
WCAG contrast ratio (4.5, or 3 for large text) computed from the page's own colors, the smallest
text, the type sizes and font families in use, broken images, script errors, missing files and any
request to another address (a page here may load only its own files); and under "taste" what the
designer skill checks: decoration (gradients, glows, pills, rounded boxes, emoji, placeholder text,
accent hues), the first screen in order of visual weight, and the accessibility basics.

Prints a few plain lines, and with --json writes every finding. Exit 0 when the page loaded (even with
findings), 1 when it could not be loaded, 2 on a usage error. Only Python's standard library.
"""
import argparse, fcntl, http.server, json, os, shutil, socketserver, struct, subprocess, sys, tempfile, threading, time
from pathlib import Path
from urllib.parse import unquote, urlparse

CANDIDATES = ["/usr/bin/chromium-headless-shell", "/usr/lib/chromium/chromium-headless-shell", "/usr/lib/chromium/headless_shell", "/usr/bin/chromium"]
TYPES = {".html": "text/html; charset=utf-8", ".htm": "text/html; charset=utf-8", ".css": "text/css", ".js": "text/javascript", ".mjs": "text/javascript",
         ".json": "application/json", ".csv": "text/csv; charset=utf-8", ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg",
         ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp", ".woff2": "font/woff2", ".woff": "font/woff", ".ttf": "font/ttf",
         ".otf": "font/otf", ".txt": "text/plain; charset=utf-8", ".geojson": "application/json", ".ico": "image/x-icon", ".pdf": "application/pdf"}
MAX_HEIGHT = 12000

# Runs in the page. Returns everything a program can judge without eyes.
MEASURE = r"""
(() => {
  const vw = window.innerWidth, out = {}
  const de = document.documentElement, body = document.body
  out.viewport_width = vw
  out.scroll_width = de.scrollWidth
  out.horizontal_scroll = Math.max(0, de.scrollWidth - vw)
  out.page_height = Math.max(de.scrollHeight, body ? body.scrollHeight : 0)
  out.title = document.title || ''
  const parse = (c) => { const m = /rgba?\(([^)]+)\)/.exec(c || ''); if (!m) return null; const p = m[1].split(/[\s,\/]+/).filter(Boolean).map(Number); return { r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 } }
  const lin = (v) => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4) }
  const lum = (c) => 0.2126 * lin(c.r) + 0.7152 * lin(c.g) + 0.0722 * lin(c.b)
  const over = (t, b) => ({ r: t.r * t.a + b.r * (1 - t.a), g: t.g * t.a + b.g * (1 - t.a), b: t.b * t.a + b.b * (1 - t.a), a: 1 })
  const hex = (c) => '#' + [c.r, c.g, c.b].map((v) => Math.round(v).toString(16).padStart(2, '0')).join('')
  const label = (el) => { let s = el.tagName.toLowerCase(); if (el.id) s += '#' + el.id; else if (typeof el.className === 'string' && el.className.trim()) s += '.' + el.className.trim().split(/\s+/).slice(0, 2).join('.'); return s }
  const say = (el) => (el.innerText || el.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 60)
  function background(el) {
    const layers = []
    for (let e = el; e; e = e.parentElement) {
      const s = getComputedStyle(e)
      if (s.backgroundImage && s.backgroundImage !== 'none') return null
      const c = parse(s.backgroundColor)
      if (c && c.a > 0) { layers.push(c); if (c.a >= 1) break }
    }
    let base = { r: 255, g: 255, b: 255, a: 1 }
    for (let i = layers.length - 1; i >= 0; i--) base = over(layers[i], base)
    return base
  }
  function scrollerAbove(el) {
    for (let e = el.parentElement; e && e !== body && e !== de; e = e.parentElement) {
      const ox = getComputedStyle(e).overflowX
      if (ox === 'auto' || ox === 'scroll') return true
    }
    return false
  }
  const seen = new Set(), sizes = {}, families = {}, colors = {}
  const lowContrast = [], small = [], clipped = [], pastEdge = []
  let unknownBg = 0, texts = 0, minSize = Infinity
  const walker = document.createTreeWalker(body || de, NodeFilter.SHOW_TEXT)
  for (let n = walker.nextNode(); n; n = walker.nextNode()) {
    if (!n.textContent.trim()) continue
    const el = n.parentElement
    if (!el || seen.has(el)) continue
    seen.add(el)
    const s = getComputedStyle(el)
    if (s.visibility === 'hidden' || s.display === 'none' || ['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE'].includes(el.tagName)) continue
    const r = el.getBoundingClientRect()
    if (r.width < 1 || r.height < 1) continue
    let op = 1
    for (let e = el; e; e = e.parentElement) op *= Number(getComputedStyle(e).opacity)
    if (op < 0.05) continue
    texts++
    const size = parseFloat(s.fontSize), weight = Number(s.fontWeight) || 400
    sizes[Math.round(size * 2) / 2] = (sizes[Math.round(size * 2) / 2] || 0) + 1
    const fam = (s.fontFamily.split(',')[0] || '').replace(/["']/g, '').trim()
    families[fam] = (families[fam] || 0) + 1
    if (size < minSize) minSize = size
    if (size < 12) small.push({ where: label(el), text: say(el), size })
    const bg = background(el), fg = parse(s.color)
    if (!bg || !fg) unknownBg++
    else {
      const f = over({ ...fg, a: fg.a * op }, bg)
      const L1 = lum(f), L2 = lum(bg)
      const ratio = (Math.max(L1, L2) + 0.05) / (Math.min(L1, L2) + 0.05)
      const large = size >= 24 || (size >= 18.66 && weight >= 700)
      colors[hex(f)] = (colors[hex(f)] || 0) + 1
      if (ratio < (large ? 3 : 4.5)) lowContrast.push({ where: label(el), text: say(el), ratio: Math.round(ratio * 100) / 100, needs: large ? 3 : 4.5, color: hex(f), background: hex(bg) })
    }
    const ox = s.overflowX, oy = s.overflowY
    if ((el.scrollWidth > el.clientWidth + 1 && (ox === 'hidden' || ox === 'clip' || s.textOverflow === 'ellipsis')) ||
        (el.scrollHeight > el.clientHeight + 2 && (oy === 'hidden' || oy === 'clip') && el.clientHeight > 0))
      clipped.push({ where: label(el), text: say(el) })
    if (r.right > vw + 1 && !scrollerAbove(el)) pastEdge.push({ where: label(el), text: say(el), right: Math.round(r.right) })
  }
  for (const el of document.querySelectorAll('img, svg, canvas, table, pre, iframe, video')) {
    const r = el.getBoundingClientRect()
    if (r.width > 0 && r.right > vw + 1 && !scrollerAbove(el)) pastEdge.push({ where: label(el), text: '', right: Math.round(r.right) })
  }
  out.texts = texts
  out.smallest_text_px = texts ? minSize : null
  out.text_sizes = sizes
  out.font_families = families
  out.text_colors = Object.keys(colors).length
  out.low_contrast = lowContrast.slice(0, 30)
  out.low_contrast_count = lowContrast.length
  out.contrast_unknown = unknownBg
  out.small_text = small.slice(0, 30)
  out.small_text_count = small.length
  out.clipped = clipped.slice(0, 30)
  out.clipped_count = clipped.length
  out.past_right_edge = pastEdge.slice(0, 30)
  out.past_right_edge_count = pastEdge.length
  // reading text: the most common size, and paragraphs whose lines run past about 90 characters
  let body_px = null, most = 0
  for (const [k, v] of Object.entries(sizes)) if (v > most) { most = v; body_px = Number(k) }
  out.body_text_px = body_px
  out.long_lines = [...document.querySelectorAll('p, li, dd, blockquote')].filter((el) => {
    const t = (el.innerText || '').trim(); if (t.length < 160) return false
    const s = getComputedStyle(el), r = el.getBoundingClientRect()
    return r.width / (parseFloat(s.fontSize) * 0.5) > 90
  }).length
  out.h1_count = document.querySelectorAll('h1').length
  // without it a phone lays the page out about 980 px wide and shrinks it to fit: tiny text
  out.has_viewport_meta = /width\s*=\s*device-width/i.test(document.querySelector('meta[name=viewport]')?.getAttribute('content') || '')
  out.broken_images =[...document.images].filter((i) => i.complete && i.naturalWidth === 0).map((i) => i.getAttribute('src')).slice(0, 20)
  out.headings = [...document.querySelectorAll('h1,h2,h3')].map((h) => h.tagName.toLowerCase() + ' ' + say(h)).slice(0, 40)
  try { out.taste = taste() } catch (e) { out.taste = { error: String(e).slice(0, 120) } }
  return JSON.stringify(out)

  // What a program can see of the two failures the designer skill names (decorated and bare), the
  // order of importance on the first screen, and the accessibility basics. Counts and labels only.
  function taste() {
    const vh = window.innerHeight, t = { gradients: [], glows: [], shadows: 0, round_boxes: 0, pills: 0, glass: 0, emoji: 0,
      h1_accent: false, tiny_caps_labels: 0, centered_long_text: 0, placeholder: [], accent_hues: [], pictures: 0 }
    const sat = (c) => (Math.max(c.r, c.g, c.b) - Math.min(c.r, c.g, c.b)) / 255
    const hueOf = (c) => { const r = c.r / 255, g = c.g / 255, b = c.b / 255, mx = Math.max(r, g, b), d = mx - Math.min(r, g, b); if (!d) return 0
      let h = mx === r ? ((g - b) / d) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; h *= 60; return h < 0 ? h + 360 : h }
    const hues = {}
    const note = (c, w) => { if (!c || c.a < 0.5 || !w || sat(c) < 0.2) return; const k = (Math.round(hueOf(c) / 30) % 12) * 30; hues[k] = (hues[k] || 0) + w }
    const own = (el) => [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim())
    for (const el of (body ? body.querySelectorAll('*') : [])) {
      const s = getComputedStyle(el), r = el.getBoundingClientRect()
      if (r.width < 1 || r.height < 1 || s.display === 'none' || s.visibility === 'hidden') continue
      if (/gradient\(/.test(s.backgroundImage)) t.gradients.push(label(el))
      if (s.boxShadow && s.boxShadow !== 'none') {
        t.shadows++
        const blur = Math.max(0, ...[...s.boxShadow.matchAll(/(-?[\d.]+)px\s+(-?[\d.]+)px\s+([\d.]+)px/g)].map((m) => +m[3]))
        const col = parse(s.boxShadow), inset = /inset/.test(s.boxShadow)
        // an inset hard line (an underline, a rule) is not a glow; a wide blur or a colored halo is
        if (!(inset && blur < 4) && (blur >= 24 || (col && sat(col) >= 0.2 && blur > 0))) t.glows.push(label(el))
      }
      if (s.textShadow && s.textShadow !== 'none') t.glows.push(label(el))
      if ((s.backdropFilter && s.backdropFilter !== 'none') || /blur/.test(s.filter)) t.glass++
      const rad = parseFloat(s.borderTopLeftRadius) || 0, bgc = parse(s.backgroundColor)
      const filled = (bgc && bgc.a > 0) || parseFloat(s.borderTopWidth) > 0
      if (filled && rad >= 12 && r.width >= 120 && r.height >= 64) t.round_boxes++
      if (filled && r.height <= 40 && rad >= r.height / 2 - 1 && r.width < 260 && own(el) && !['BUTTON', 'A', 'INPUT', 'SELECT', 'LABEL'].includes(el.tagName)) t.pills++
      note(bgc, Math.min(r.width * r.height, vw * vh) / 20000)
      if (own(el)) note(parse(s.color), 1)
      if (parseFloat(s.borderTopWidth) > 0) note(parse(s.borderTopColor), 0.5)
      if (el instanceof SVGElement && el.tagName !== 'svg') note(parse(s.fill), Math.min(r.width * r.height, 40000) / 4000)
      if (['svg', 'IMG', 'CANVAS', 'PICTURE', 'VIDEO'].includes(el.tagName) && r.width >= 120 && r.height >= 80) t.pictures++
      if (s.textTransform === 'uppercase' && parseFloat(s.fontSize) <= 13 && own(el)) t.tiny_caps_labels++
      if (s.textAlign === 'center' && ['P', 'LI', 'DD'].includes(el.tagName) && (el.innerText || '').length > 180) t.centered_long_text++
    }
    t.accent_hues = Object.entries(hues).filter(([, w]) => w >= 3).sort((a, b) => b[1] - a[1]).map(([k]) => Number(k))
    const words = body ? body.innerText : ''
    t.emoji = [...words.matchAll(/\p{Extended_Pictographic}/gu)].filter((m) => !'©®™'.includes(m[0])).length
    const ph = /lorem ipsum|dolor sit amet|your (headline|title|text|tagline|name) here|placeholder text|\bTBD\b|\bTODO\b|john doe|jane doe|acme (inc|corp)|example\.com|xxx-xxxx|\b(foo|bar)baz\b/gi
    t.placeholder = [...new Set([...words.matchAll(ph)].map((m) => m[0]))].slice(0, 8)
    for (const h of document.querySelectorAll('h1')) {
      const hc = getComputedStyle(h).color
      for (const k of h.querySelectorAll('*')) { const s = getComputedStyle(k); if (s.fontStyle === 'italic' || (s.color !== hc && sat(parse(s.color) || { r: 0, g: 0, b: 0 }) >= 0.2)) t.h1_accent = true }
    }
    const bg = background(body || de)
    t.background = bg ? hex(bg) : null
    // The first screen, in order of visual weight (size times weight): what a reader sees first.
    const first = []
    for (const el of seen) {
      const r = el.getBoundingClientRect(), s = getComputedStyle(el)
      if (r.top >= vh || r.bottom <= 0 || r.width < 1 || s.display === 'none' || s.visibility === 'hidden') continue
      const size = parseFloat(s.fontSize), w = Number(s.fontWeight) || 400
      first.push({ text: say(el).slice(0, 40), size, weight: w, score: Math.round(size * size * (w / 400)) })
    }
    first.sort((a, b) => b.score - a.score)
    t.first_screen = first.slice(0, 6)
    t.rivals = first.length ? first.filter((x) => x.score >= first[0].score * 0.7).length : 0
    const h1 = document.querySelector('h1')
    t.h1_px = h1 ? parseFloat(getComputedStyle(h1).fontSize) : null
    // the reading size: the size most of the running text is set in (paragraphs, list items, cells),
    // by amount of text, so a chart's many small labels do not count as the reading text
    const read = {}
    for (const el of document.querySelectorAll('p, li, dd, blockquote, td')) {
      const n = (el.innerText || '').trim().length
      if (n && !el.closest('svg')) { const k = Math.round(parseFloat(getComputedStyle(el).fontSize) * 2) / 2; read[k] = (read[k] || 0) + n }
    }
    t.reading_px = Object.keys(read).length ? Number(Object.entries(read).sort((a, b) => b[1] - a[1])[0][0]) : body_px
    t.contrast_of_sizes = t.reading_px && first.length ? Math.round((first[0].size / t.reading_px) * 10) / 10 : null
    // accessibility basics
    t.images_without_alt = [...document.images].filter((i) => !i.hasAttribute('alt')).length
    t.unlabeled_pictures = [...document.querySelectorAll('svg, canvas')].filter((e) => { const r = e.getBoundingClientRect(); return r.width >= 120 && r.height >= 80 && !e.closest('[aria-hidden=true]') &&
      !(e.getAttribute('role') === 'img' && (e.getAttribute('aria-label') || e.querySelector('title') || e.getAttribute('aria-labelledby'))) && !e.closest('figure')?.querySelector('figcaption') }).length
    t.unlabeled_inputs = [...document.querySelectorAll('input, select, textarea')].filter((i) => !['hidden', 'submit', 'button', 'reset', 'image'].includes(i.type) &&
      !(i.id && document.querySelector(`label[for="${CSS.escape(i.id)}"]`)) && !i.closest('label') && !i.getAttribute('aria-label') && !i.getAttribute('aria-labelledby')).length
    let lvl = 0; t.heading_skips = 0
    for (const h of document.querySelectorAll('h1,h2,h3,h4,h5,h6')) { const n = +h.tagName[1]; if (lvl && n > lvl + 1) t.heading_skips++; lvl = n }
    let focusRules = 0, motionRule = false, outlineKilled = 0
    for (const sh of document.styleSheets) {
      let rules; try { rules = sh.cssRules } catch { continue }
      const walk = (list) => { for (const ru of list) {
        if (ru.media && /prefers-reduced-motion/.test(ru.media.mediaText)) motionRule = true
        if (ru.cssRules) walk(ru.cssRules)
        if (ru.selectorText && /:focus/.test(ru.selectorText)) focusRules++
        if (ru.selectorText && ru.style && /^(none|0)/.test(ru.style.outlineStyle || ru.style.outline || 'x') && !/:focus-visible/.test(ru.selectorText)) outlineKilled++ } }
      walk(rules)
    }
    t.focus_rules = focusRules
    t.outline_removed = outlineKilled
    const moving = [...document.querySelectorAll('*')].some((e) => { const s = getComputedStyle(e); return (s.animationName && s.animationName !== 'none') || parseFloat(s.transitionDuration) > 0.2 })
    t.motion_without_reduced_motion = moving && !motionRule
    t.interactive = document.querySelectorAll('a[href], button, input:not([type=hidden]), select, textarea').length
    t.small_targets = vw < 700 ? [...document.querySelectorAll('button, input:not([type=hidden]), select, a')].filter((e) => {
      const s = getComputedStyle(e), r = e.getBoundingClientRect(); return r.width > 0 && s.display !== 'inline' && r.height < 32 }).length : 0
    return t
  }
})()
"""


# Runs in the page before MEASURE when --do is given (OLA-174): the steps a person would take, at once.
# Synchronous on purpose: the Mac app's web view evaluates a script without awaiting it.
DO = r"""
((steps) => {
  const vis = (e) => { const r = e.getBoundingClientRect(), s = getComputedStyle(e); return r.width > 0 && r.height > 0 && s.visibility !== 'hidden' && s.display !== 'none' }
  const fields = () => [...document.querySelectorAll('input:not([type=hidden]):not([type=button]):not([type=submit]):not([type=reset]):not([type=checkbox]):not([type=radio]), textarea, select')].filter(vis)
  const said = (e) => [(e.innerText || ''), e.value, e.getAttribute('aria-label'), e.title, e.getAttribute('alt')].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim()
  const label = (e) => [e.placeholder, e.name, e.id, e.getAttribute('aria-label'), e.labels && e.labels[0] && e.labels[0].innerText].filter(Boolean).join(' ').toLowerCase()
  const set = (el, v) => {
    if (el.tagName === 'SELECT') {
      const o = [...el.options].find((o) => o.value === v || o.text.trim().toLowerCase() === v.toLowerCase())
      if (!o) return 'no choice "' + v + '" in the list (it has: ' + [...el.options].map((o) => o.text.trim()).slice(0, 8).join(', ') + ')'
      el.value = o.value
    } else {
      const proto = el.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype
      el.focus(); Object.getOwnPropertyDescriptor(proto, 'value').set.call(el, v)
    }
    el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true }))
    return ''
  }
  const out = []; let last = null
  for (const raw of steps) {
    const sp = raw.trim(), i = sp.indexOf(' '), op = (i < 0 ? sp : sp.slice(0, i)).toLowerCase(), arg = i < 0 ? '' : sp.slice(i + 1).trim()
    let r = ''
    try {
      if (op === 'fill') {
        const eq = arg.indexOf('='); if (eq < 0) throw new Error('write it as fill <n or words>=<value>')
        const who = arg.slice(0, eq).trim(), v = arg.slice(eq + 1), f = fields()
        const el = /^\d+$/.test(who) ? f[Number(who) - 1] : f.find((x) => label(x).includes(who.toLowerCase()))
        if (!el) throw new Error('no field ' + who + ' (the page has ' + f.length + ' field' + (f.length === 1 ? '' : 's') + (f.length ? ': ' + f.map((x, n) => (n + 1) + ' ' + (label(x) || x.type || x.tagName.toLowerCase())).slice(0, 8).join('; ') : '') + ')')
        r = set(el, v); if (r) throw new Error(r); last = el; r = 'ok'
      } else if (op === 'click') {
        let el
        if (arg.startsWith('css:')) el = [...document.querySelectorAll(arg.slice(4))].filter(vis)[0]
        else {
          const want = arg.toLowerCase(), tries = [...document.querySelectorAll('button, input[type=button], input[type=submit], [role=button], a, [onclick], label, summary')].filter(vis)
          el = tries.find((e) => said(e).toLowerCase() === want) || tries.find((e) => said(e).toLowerCase().includes(want))
            || [...document.querySelectorAll('body *')].filter((e) => vis(e) && !e.children.length && said(e).toLowerCase().includes(want))[0]
        }
        if (!el) throw new Error('nothing to click with "' + arg + '"')
        el.click(); r = 'ok (' + (said(el).slice(0, 30) || el.tagName.toLowerCase()) + ')'
      } else if (op === 'press') {
        const el = last || document.activeElement; if (!el) throw new Error('no field to press in')
        for (const t of ['keydown', 'keypress', 'keyup']) el.dispatchEvent(new KeyboardEvent(t, { key: 'Enter', code: 'Enter', keyCode: 13, which: 13, bubbles: true }))
        if (el.form && el.form.requestSubmit) el.form.requestSubmit()
        r = 'ok'
      } else throw new Error('unknown step (fill, click or press)')
    } catch (e) { r = 'FAILED: ' + (e && e.message || e) }
    out.push(sp + ' -> ' + r)
  }
  return out
})"""


# The words a person sees, after the steps: visible text in reading order, each field as [its value],
# a list as [its choice], a box as [x] or [ ] (a select's innerText would list every option).
WORDS = r"""
(() => {
  const out = [], block = /^(DIV|P|LI|H[1-6]|TR|SECTION|ARTICLE|HEADER|FOOTER|MAIN|UL|OL|TABLE|FORM|BR|NAV|ASIDE|DT|DD|FIELDSET)$/
  const walk = (n) => {
    if (n.nodeType === 3) { if (n.textContent.trim()) out.push(n.textContent.replace(/\s+/g, ' ')); return }
    if (n.nodeType !== 1 || /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE|OPTION)$/.test(n.tagName)) return
    const s = getComputedStyle(n), tag = n.tagName
    if (s.display === 'none' || s.visibility === 'hidden') return
    if (tag === 'SELECT') { out.push(' [' + (n.selectedOptions[0] ? n.selectedOptions[0].text.trim() : '') + '] '); return }
    if (tag === 'INPUT') {
      if (n.type === 'hidden') return
      out.push(/^(checkbox|radio)$/.test(n.type) ? (n.checked ? ' [x] ' : ' [ ] ') : /^(button|submit|reset)$/.test(n.type) ? ' ' + n.value + ' ' : ' [' + n.value + '] ')
      return
    }
    if (tag === 'TEXTAREA') { out.push(' [' + n.value.slice(0, 200) + '] '); return }
    if (tag === 'CANVAS') { out.push(' [a drawing on a canvas: look at the picture] '); return }
    const b = block.test(tag) || /^(block|flex|grid|table-row|list-item)$/.test(s.display)
    if (b) out.push('\n')
    for (const c of n.childNodes) walk(c)
    if (b) out.push('\n')
  }
  if (document.body) walk(document.body)
  return out.join('').split('\n').map((l) => l.replace(/\s+/g, ' ').trim()).filter(Boolean).join('\n').slice(0, 3000)
})()"""


def measure_script(a):
    """The script run in the page: MEASURE, after the --do steps when there are any, with the text."""
    steps = getattr(a, "do", None) or []
    if not steps and not getattr(a, "text", False):
        return MEASURE
    return ("(() => { const did = " + DO + "(" + json.dumps(steps) + "); const r = JSON.parse(" + MEASURE.strip() + ");"
            " r.did = did; r.text = " + WORDS.strip() + ";"
            " return JSON.stringify(r) })()")


class Quiet(http.server.SimpleHTTPRequestHandler):
    root = "/"

    def log_message(self, *a):
        pass

    def do_GET(self):
        rel = unquote(urlparse(self.path).path).lstrip("/") or "index.html"
        f = (Path(self.root) / rel).resolve()
        if not str(f).startswith(str(Path(self.root).resolve()) + os.sep) and f != Path(self.root).resolve():
            self.send_error(403)
            return
        if f.is_dir():
            f = f / "index.html"
        try:
            body = f.read_bytes()
        except OSError:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", TYPES.get(f.suffix.lower(), "application/octet-stream"))
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    do_HEAD = do_GET


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


class CDP:
    """Chrome DevTools Protocol over --remote-debugging-pipe (fd 3 in, fd 4 out, NUL-separated JSON)."""

    def __init__(self, binary, profile):
        r_in, self.w = os.pipe()
        self.r, w_out = os.pipe()

        def wire():
            a = fcntl.fcntl(r_in, fcntl.F_DUPFD, 10)
            b = fcntl.fcntl(w_out, fcntl.F_DUPFD, 10)
            os.dup2(a, 3)
            os.dup2(b, 4)
            # A page is someone else's code (review 5 follow-up): the browser and every process it
            # starts may hold OLA_PAGE_MEM_MB (2048) of written memory and write files of 256 MiB at
            # most, so a page that grows without end fails here instead of taking the computer's
            # memory (and opencode with it). Address space is not capped: the browser reserves a lot.
            try:
                import resource
                mem = int(os.environ.get("OLA_PAGE_MEM_MB", "2048")) << 20
                resource.setrlimit(resource.RLIMIT_DATA, (mem, mem))
                resource.setrlimit(resource.RLIMIT_FSIZE, (256 << 20, 256 << 20))
            except (ImportError, ValueError, OSError):
                pass

        args = [binary, "--headless", "--no-sandbox", "--disable-gpu", "--disable-dev-shm-usage", "--remote-debugging-pipe",
                f"--user-data-dir={profile}", "--no-first-run", "--no-default-browser-check", "--disable-background-networking",
                "--disable-component-update", "--disable-sync", "--disable-extensions", "--mute-audio", "--hide-scrollbars",
                "--disable-features=Translate,MediaRouter,OptimizationHints", "--font-render-hinting=none",
                "--js-flags=--max-old-space-size=512", "--renderer-process-limit=1", "about:blank"]
        self.p = subprocess.Popen(args, preexec_fn=wire, close_fds=False, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.close(r_in)
        os.close(w_out)
        self.buf = b""
        self.n = 0
        self.events = []

    def send(self, method, params=None, session=None, timeout=30):
        self.n += 1
        msg = {"id": self.n, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        os.write(self.w, json.dumps(msg).encode() + b"\0")
        want = self.n
        end = time.time() + timeout
        while time.time() < end:
            for m in self.read(end - time.time()):
                if m.get("id") == want:
                    if "error" in m:
                        raise RuntimeError(f"{method}: {m['error'].get('message')}")
                    return m.get("result", {})
                self.events.append(m)
        raise TimeoutError(method)

    def read(self, timeout):
        import select
        r, _, _ = select.select([self.r], [], [], max(0.0, min(timeout, 1.0)))
        if not r:
            return []
        chunk = os.read(self.r, 1 << 20)
        if not chunk:
            raise RuntimeError("the page renderer stopped")
        self.buf += chunk
        out = []
        while b"\0" in self.buf:
            one, self.buf = self.buf.split(b"\0", 1)
            try:
                out.append(json.loads(one))
            except ValueError:
                pass
        return out

    def pump(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            self.events.extend(self.read(end - time.time()))

    def close(self):
        try:
            self.p.kill()
            self.p.wait(5)
        except Exception:
            pass


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24]) if head[:8] == b"\x89PNG\r\n\x1a\n" else (0, 0)


def arguments():
    """The command line, shared with the Mac's ola-page (bart/ola-page-mac), which renders in the app's web view."""
    ap = argparse.ArgumentParser(prog="ola-page", description="Screenshot a page and measure what a program can see.")
    ap.add_argument("page")
    ap.add_argument("--width", type=int, default=1280)
    ap.add_argument("--height", type=int, default=900, help="the window's height (the shot is the whole page unless --viewport)")
    ap.add_argument("--out", required=True)
    ap.add_argument("--json")
    ap.add_argument("--viewport", action="store_true", help="only what fits in the window, not the whole page")
    ap.add_argument("--wait", type=int, default=600, help="milliseconds to let the page settle after it loads")
    ap.add_argument("--scale", type=float, default=1.0)
    ap.add_argument("--dark", action="store_true", help="as a browser set to dark mode shows it (prefers-color-scheme: dark)")
    ap.add_argument("--do", action="append", metavar="STEP", help='a step to take before the look, in order: "fill 1=Buy milk", "fill due=2026-12-01", "click Add", "click css:.tile", "press Enter"')
    ap.add_argument("--text", action="store_true", help="print the words on the page (after the --do steps)")
    return ap


# A hard stop on checking (OLA-447): a model kept rendering one finished page for more than ten
# minutes. Two looks at a page per request (OLA-455: six still let a 15-minute hunt for one bug run); the
# third does nothing and says to hand over. Ten quiet minutes start a new count. Looks made by the
# designer's look.py are counted there (two), not here.
PAGE_LOOKS_MAX = 2
PAGE_LOOKS_GAP_S = 600


def looked_enough(page):
    if os.environ.get("OLA_FROM_LOOK") == "1":
        return False
    if not str(Path(page).resolve()).startswith("/work/"):  # only a page in the person's project is counted
        return False
    f = Path(".shots") / ".page-looks.json"
    now = time.time()
    try:
        seen = json.loads(f.read_text())
    except Exception:
        seen = {}
    key = str(Path(page).resolve())
    times = [t for t in seen.get(key, []) if isinstance(t, (int, float))]
    if times and now - times[-1] > PAGE_LOOKS_GAP_S:
        times = []
    if len(times) >= PAGE_LOOKS_MAX:
        return True
    seen[key] = times + [now]
    try:
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(seen))
    except OSError:
        pass
    return False


def main():
    a = arguments().parse_args()
    if looked_enough(a.page):
        print("ola-page: you have looked at this page twice already, and that is the limit. Do not check it again, "
              "with this or any other command. Tell the person now, in two or three sentences, what is ready, and name "
              "anything you saw and did not fix.")
        return 0
    page = Path(a.page).resolve()
    if not page.is_file():
        print(f"ola-page: no such page: {a.page}", file=sys.stderr)
        return 2
    if not 200 <= a.width <= 3000 or not 200 <= a.height <= 4000:
        print("ola-page: --width and --height must be 200 to 3000 (4000 for height)", file=sys.stderr)
        return 2
    binary = os.environ.get("OLA_PAGE_CHROMIUM") or next((c for c in CANDIDATES if os.access(c, os.X_OK)), None) or shutil.which("chromium-headless-shell")
    if not binary:
        print("ola-page: no page renderer is installed on this computer", file=sys.stderr)
        return 1
    Quiet.root = str(page.parent)
    srv = Server(("127.0.0.1", 0), Quiet)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    base = f"http://127.0.0.1:{srv.server_address[1]}/"
    url = base + "/".join(page.relative_to(page.parent).parts)
    profile = tempfile.mkdtemp(prefix="ola-page-")
    cdp = None
    # The whole look has a deadline (review 5 follow-up): a page that never settles, or loops in its
    # script, ends here with the browser stopped, never later.
    import signal

    def overdue(*_):
        raise TimeoutError("the page took longer than %d s" % deadline)
    deadline = int(os.environ.get("OLA_PAGE_DEADLINE_S", "150"))
    signal.signal(signal.SIGALRM, overdue)
    signal.alarm(deadline)
    report = {"page": a.page, "width": a.width}
    try:
        cdp = CDP(binary, profile)
        tid = cdp.send("Target.createTarget", {"url": "about:blank"})["targetId"]
        sid = cdp.send("Target.attachToTarget", {"targetId": tid, "flatten": True})["sessionId"]
        for m in ("Page.enable", "Runtime.enable", "Network.enable", "Log.enable"):
            cdp.send(m, session=sid)
        cdp.send("Emulation.setDeviceMetricsOverride", {"width": a.width, "height": a.height, "deviceScaleFactor": a.scale, "mobile": False}, session=sid)
        if a.dark:
            cdp.send("Emulation.setEmulatedMedia", {"features": [{"name": "prefers-color-scheme", "value": "dark"}]}, session=sid)
        cdp.send("Page.navigate", {"url": url}, session=sid)
        end = time.time() + 20
        while time.time() < end and not any(e.get("method") == "Page.loadEventFired" for e in cdp.events):
            cdp.pump(0.25)
        loaded = any(e.get("method") == "Page.loadEventFired" for e in cdp.events)
        cdp.pump(a.wait / 1000)
        res = cdp.send("Runtime.evaluate", {"expression": measure_script(a), "returnByValue": True}, session=sid)
        report.update(json.loads(res["result"]["value"]))
        h = a.height if a.viewport else min(max(report.get("page_height") or a.height, a.height), MAX_HEIGHT)
        shot = cdp.send("Page.captureScreenshot", {"format": "png", "captureBeyondViewport": not a.viewport,
                                                   "clip": {"x": 0, "y": 0, "width": a.width, "height": h, "scale": 1}}, session=sid, timeout=60)
        import base64
        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
        Path(a.out).write_bytes(base64.b64decode(shot["data"]))
        outside, missing, errors = [], [], []
        for e in cdp.events:
            m, p = e.get("method"), e.get("params", {})
            if m == "Network.requestWillBeSent":
                u = p.get("request", {}).get("url", "")
                if not u.startswith(base) and not u.startswith(("data:", "blob:", "about:")):
                    outside.append(u[:200])
            elif m == "Network.responseReceived" and p.get("response", {}).get("status") == 404:
                missing.append(urlparse(p["response"]["url"]).path)
            elif m == "Runtime.exceptionThrown":
                d = p.get("exceptionDetails", {})
                errors.append(((d.get("exception") or {}).get("description") or d.get("text") or "error").split("\n")[0][:200])
            elif m == "Log.entryAdded" and p.get("entry", {}).get("level") == "error" and p["entry"].get("source") != "network":
                errors.append(p["entry"].get("text", "")[:200])
        report.update({"loaded": loaded, "outside_requests": sorted(set(outside))[:20], "missing_files": sorted(set(missing))[:20],
                       "script_errors": errors[:20], "shot": a.out, "shot_size": list(png_size(a.out))})
    except Exception as e:
        print(f"ola-page: could not load the page ({type(e).__name__}: {str(e)[:160]})", file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)
        if cdp:
            cdp.close()
        srv.shutdown()
        shutil.rmtree(profile, ignore_errors=True)
    return finish(a, report)


def finish(a, report):
    """Writes --json and prints the plain lines about what was measured."""
    if a.json:
        Path(a.json).write_text(json.dumps(report, indent=1))
    w, hh = report["shot_size"]
    print(f"Saved {a.out} ({w} x {hh} px) of {a.page} at {a.width} px wide.")
    lines = [
        f"sideways scroll: {report['horizontal_scroll']} px" + (" (the page is wider than the window)" if report["horizontal_scroll"] else ""),
        f"past the right edge: {report['past_right_edge_count']}",
        f"clipped text: {report['clipped_count']}",
        f"text below the contrast it needs: {report['low_contrast_count']}" + (f" ({report['contrast_unknown']} on images or gradients not measured)" if report["contrast_unknown"] else ""),
        f"smallest text: {report['smallest_text_px']} px; sizes in use: {len(report['text_sizes'])}; fonts: {', '.join(list(report['font_families'])[:4]) or 'none'}",
        f"requests to other addresses: {len(report['outside_requests'])}; missing files: {len(report['missing_files'])}; broken images: {len(report['broken_images'])}; script errors: {len(report['script_errors'])}",
    ]
    for l in lines:
        print("  " + l)
    for key, say in (("low_contrast", "low contrast"), ("past_right_edge", "past the edge"), ("clipped", "clipped"), ("small_text", "small text")):
        for x in report[key][:5]:
            extra = f" ratio {x['ratio']} (needs {x['needs']}), {x['color']} on {x['background']}" if key == "low_contrast" else (f" {x['size']} px" if key == "small_text" else "")
            print(f"    {say}: {x['where']} \"{x['text'][:40]}\"{extra}")
    for d in report.get("did") or []:
        print("  step: " + d)
    if getattr(a, "text", False):
        print("  the words on the page:")
        for l in (report.get("text") or "(none)").split("\n")[:80]:
            print("    " + l[:160])
    if not report["loaded"]:
        print("  the page never finished loading (it may wait on something that cannot load here)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
