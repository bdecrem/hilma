class _DoorConnection(http.client.HTTPConnection):
    def connect(self):
        import socket
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(DOOR)
        self.sock = s


def gw_request(method, path, body, token, headers=None, timeout=900):
    if "OLA_BATCH_GATEWAY" not in os.environ and os.path.exists(DOOR):
        c = _DoorConnection("gateway", timeout=timeout)
    else:
        u = GATEWAY.split("://", 1)[1]
        host, _, port = u.partition(":")
        c = http.client.HTTPConnection(host, int(port or 80), timeout=timeout)
    try:
        h = {"Authorization": "Bearer " + token, "Accept": "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            h["Content-Type"] = "application/json"
        h.update(headers or {})
        c.request(method, path, data, h)
        r = c.getresponse()
        return r.status, dict((k.lower(), v) for k, v in r.getheaders()), r.read(16 * 1024 * 1024).decode("utf-8", "replace")
    finally:
        c.close()


class Wait(Exception):
    """The machine or the model is busy: wait, then try the same document again."""
    def __init__(self, seconds, note):
        self.seconds, self.note = seconds, note


class Refused(Exception):
    """The gateway said no (no grant for this job, the outside model off): final after a short wait."""
    def __init__(self, note):
        self.note = note


class Stop(Exception):
    """Nothing more can be done now (the budget, a refusal): the job is paused with this note."""
    def __init__(self, note):
        self.note = note


def ask_model(job, messages):
    """One model call. Returns (text, tokens_in, tokens_out)."""
    token = os.environ.get("BOX_API_KEY", "")
    lane = {"X-Ola-Lane": "batch", "X-Ola-Job": job["id"], **({"X-Ola-Job-Key": RUNNER_KEY} if RUNNER_KEY else {})}
    model = job["model"]
    try:
        if model == "claude":
            sysmsg = messages[0]["content"]
            body = {"model": CLAUDE_MODEL, "max_tokens": 4000, "system": sysmsg, "messages": messages[1:]}
            st, h, raw = gw_request("POST", "/anthropic/v1/messages", body, token, dict(lane, **{"anthropic-version": "2023-06-01"}))
        else:
            body = {"model": model, "messages": messages, "max_tokens": 1500 + 150 * len(job["fields"]), "temperature": 0}
            st, h, raw = gw_request("POST", "/v1/chat/completions", body, token, lane)
    except (OSError, http.client.HTTPException):
        raise Wait(20, "Waiting: the model cannot be reached just now. Trying again shortly.")
    err = {}
    try:
        j = json.loads(raw)
        err = j.get("error") or {}
        if not isinstance(err, dict):
            err = {}
    except ValueError:
        j = None
    msg = str(err.get("message") or "")[:300]
    if st == 200 and j:
        if model == "claude":
            text = "".join(b.get("text", "") for b in j.get("content", []) if b.get("type") == "text")
            u = j.get("usage") or {}
            return text, int(u.get("input_tokens") or 0) + int(u.get("cache_read_input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0), int(u.get("output_tokens") or 0)
        ch = (j.get("choices") or [{}])[0].get("message") or {}
        u = j.get("usage") or {}
        return ch.get("content") or "", int(u.get("prompt_tokens") or 0), int(u.get("completion_tokens") or 0)
    retry = h.get("retry-after")
    secs = int(retry) if retry and retry.isdigit() else 30
    if st == 429 and err.get("code") == "job_budget":
        raise Stop("Paused: this job used the budget that was approved for it. Raise the budget to carry on.")
    if st == 429 and err.get("type") == "insufficient_quota":
        raise Stop("Paused: " + (msg or "this project reached its limit for this model."))
    if st in (429, 503):
        raise Wait(min(max(secs, 5), 600), "Waiting: Ola's computer is busy with other work. Trying again in %d seconds." % min(max(secs, 5), 600))
    if st in (401, 403):
        # The grant can be a moment behind the person's yes (the gateway reads its file every 2 s):
        # the runner waits a little before it takes a refusal as final (run() counts them).
        raise Refused("Paused: " + (msg or "the model refused this job.").strip())
    if st >= 500:
        raise Wait(30, "Waiting: the model had a problem (%d). Trying again in 30 seconds." % st)
    raise ValueError("the model answered %d" % st)


def parse_answer(text):
    t = (text or "").strip()
    t = re.sub(r"^```(?:json)?\s*|\s*```$", "", t)
    a, b = t.find("{"), t.rfind("}")
    if a < 0 or b < a:
        return None
    try:
        x = json.loads(t[a:b + 1])
    except ValueError:
        return None
    return x if isinstance(x, dict) else None


def judge(fields, answer, pages):
    """Each field: (value, quote, page, check, problem or None)."""
    out = {}
    for f in fields:
        n = f["name"]
        a = answer.get(n) if isinstance(answer, dict) else None
        if not isinstance(a, dict):
            out[n] = (None, "", None, "no answer", "this field is missing from the answer")
            continue
        v, q, p = a.get("value"), a.get("quote") or "", a.get("page")
        if isinstance(p, str) and p.strip().isdigit():
            p = int(p.strip())
        if not isinstance(p, int) or isinstance(p, bool):
            p = None
        if isinstance(v, str) and v.strip().lower().rstrip(".") in (NOT_STATED, "not_stated", "n/a", "none stated"):
            out[n] = (NOT_STATED, "", None, "not stated", None)
            continue
        if v is None or (isinstance(v, str) and not v.strip()):
            out[n] = (None, "", None, "no answer", 'the value is empty; give a value or "not stated"')
            continue
        problem = None
        if f["type"] == "category":
            hit = next((c for c in f["values"] if isinstance(v, str) and c.lower() == v.strip().lower()), None)
            if hit is None:
                problem = 'the value must be one of: %s, or "not stated"' % ", ".join(f["values"])
            v = hit if hit is not None else str(v)[:200]
        elif f["type"] == "number":
            try:
                v = float(str(v).replace(",", "").strip()) if not isinstance(v, (int, float)) or isinstance(v, bool) else float(v)
                v = int(v) if v.is_integer() else v
            except ValueError:
                problem, v = 'the value must be a number, or "not stated"', str(v)[:200]
        elif f["type"] == "yesno":
            s = str(v).strip().lower()
            if s in ("yes", "no", "true", "false"):
                v = "yes" if s in ("yes", "true") else "no"
            else:
                problem, v = 'the value must be yes or no, or "not stated"', str(v)[:200]
        else:
            v = str(v).strip()[:1000]
        if problem:
            out[n] = (v, str(q)[:2000], p, "unusable answer", problem)
            continue
        if not isinstance(q, str) or not q.strip():
            out[n] = (v, "", p, "quote not found", "there is no quote; copy the passage that says it, exactly")
            continue
        res, at = quote_check(pages, q, p)
        if res == "quote not found":
            why = "the quote was not found in the document"
            if len(norm_quote(q).split(" ")) < MIN_QUOTE_WORDS:
                why = "the quote is too short to check (at least %d words)" % MIN_QUOTE_WORDS
            elif "..." in q or "…" in q:
                why = "the quote has an ellipsis; copy one continuous passage"
            out[n] = (v, q.strip()[:2000], p, res, why + (" (you said page %s)" % p if p is not None else ""))
        else:
            out[n] = (v, q.strip()[:2000], at, res, None)
    return out


# ------------------------------------------------------------------ the runner

def ensure_results_table(con, job, fields):
    name = job["name"]
    if con.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)).fetchone():
        return
    cols = ["document_id INTEGER PRIMARY KEY", "document TEXT"]
    for f in fields:
        k = "REAL" if f["type"] == "number" else "TEXT"
        cols += ["%s %s" % (qi(f["name"]), k), "%s TEXT" % qi(f["name"] + "_quote"), "%s INTEGER" % qi(f["name"] + "_page"), "%s TEXT" % qi(f["name"] + "_check")]
    cols += ["checked TEXT", "stage TEXT", "model TEXT", "coded_at TEXT", "machine_coded INTEGER NOT NULL DEFAULT 1"]
    con.execute("CREATE TABLE %s (%s)" % (qi(name), ", ".join(cols)))
    t = now()
    desc = ("Machine-coded by Ola, not source data: job %s, \"%s\". One row per document; every value with its quote, its page "
            "and a program's check that the quote is in the document." % (job["id"], job["title"][:200]))
    con.execute("INSERT INTO tables_catalog (name, description, source, created_at, updated_at) VALUES (?, ?, ?, ?, ?) ON CONFLICT (name) DO UPDATE SET description = excluded.description, source = excluded.source, updated_at = excluded.updated_at",
                (name, desc, "machine-coded (job %s)" % job["id"], t, t))


def beat(con, jid, note=None, keep_note=False):
    if keep_note:
        con.execute("UPDATE batch_jobs SET heartbeat_at = ? WHERE id = ?", (time.time(), jid))
    else:
        con.execute("UPDATE batch_jobs SET heartbeat_at = ?, note = ? WHERE id = ?", (time.time(), note, jid))
    con.commit()


def code_one(con, job, fields, doc_id, stage):
    title = (con.execute("SELECT title FROM documents WHERE id = ?", (doc_id,)).fetchone() or ["?"])[0]
    text, chars, pages, cut = doc_text_for_model(con, doc_id)
    t0 = time.time()
    res, tries, tin, tout = None, 0, 0, 0
    if chars < MIN_TEXT:
        state = "no_text"
        res = {f["name"]: (None, "", None, "no text", None) for f in fields}
    else:
        messages = [{"role": "system", "content": SYSTEM}, {"role": "user", "content": form_text(job, fields) + "\n\n" + text}]
        state = "done"
        while True:
            tries += 1
            reply, a, b = ask_model(job, messages)
            tin, tout = tin + a, tout + b
            ans = parse_answer(reply)
            if ans is None:
                res = {f["name"]: (None, "", None, "no answer", "the reply was not one JSON object") for f in fields}
            else:
                res = judge(fields, ans, pages)
            problems = [(n, r[4]) for n, r in res.items() if r[4]]
            if not problems or tries >= 2:
                break
            # Once more, with what was wrong. Then whatever comes back stays, marked.
            messages = messages + [{"role": "assistant", "content": (reply or "")[:20000]},
                                   {"role": "user", "content": "Some answers could not be used:\n" + "\n".join("- %s: %s" % p for p in problems) +
                                    "\nAnswer again with the whole form as one JSON object. Copy each quote exactly from the document, or answer \"not stated\"."}]
        if ans is None:
            state = "failed"
    ms = int((time.time() - t0) * 1000)
    bad = sum(1 for r in res.values() if r[3] in ("quote not found", "unusable answer", "no answer"))
    checked = "no text" if state == "no_text" else "no answer" if state == "failed" else ("all quotes found" if not bad else "%d value%s not checked" % (bad, "" if bad == 1 else "s"))
    cols, vals = ["document_id", "document"], [doc_id, title]
    for f in fields:
        v, q, p, c, _ = res[f["name"]]
        cols += [f["name"], f["name"] + "_quote", f["name"] + "_page", f["name"] + "_check"]
        vals += [v, q or None, p, c]
    cols += ["checked", "stage", "model", "coded_at", "machine_coded"]
    vals += [checked, stage, job["model"] if state != "no_text" else None, now(), 1]
    con.execute("INSERT OR REPLACE INTO %s (%s) VALUES (%s)" % (qi(job["name"]), ", ".join(qi(c) for c in cols), ", ".join("?" * len(vals))), vals)
    con.execute("UPDATE batch_items SET state = ?, tries = tries + ?, tokens_in = tokens_in + ?, tokens_out = tokens_out + ?, ms = ?, model = ?, problems = ?, done_at = ? WHERE job = ? AND doc_id = ?",
                (state, tries, tin, tout, ms, job["model"], bad, now(), job["id"], doc_id))
    con.execute("UPDATE tables_catalog SET updated_at = ? WHERE name = ?", (now(), job["name"]))
    con.commit()


def run(jid):
    os.makedirs(STATE_DIR, exist_ok=True)
    lock = open(os.path.join(STATE_DIR, jid + ".lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(json.dumps({"running": "already"}))
        sys.exit(3)
    con = connect()
    job = dict(job_row(con, jid))
    if job["state"] not in ACTIVE:
        print(json.dumps({"state": job["state"]}))
        return
    fields = json.loads(job["fields"])
    ensure_results_table(con, job, fields)
    beat(con, jid)
    # A second connection keeps the heartbeat while a model call is in flight, and ends the process
    # the moment the job is paused or cancelled (what is saved stays; the call in flight is dropped).
    stop = threading.Event()

    def keeper():
        c2 = sqlite3.connect(DB, timeout=30)
        c2.execute("PRAGMA busy_timeout = 30000")
        while not stop.wait(3):
            try:
                st = c2.execute("SELECT state FROM batch_jobs WHERE id = ?", (jid,)).fetchone()
                if not st or st[0] not in ACTIVE:
                    os._exit(0)
                c2.execute("UPDATE batch_jobs SET heartbeat_at = ? WHERE id = ?", (time.time(), jid))
                c2.commit()
            except sqlite3.Error:
                pass

    threading.Thread(target=keeper, daemon=True).start()
    refusals = 0
    while True:
        cur = con.execute("SELECT state, stage, model FROM batch_jobs WHERE id = ?", (jid,)).fetchone()
        if not cur or cur["state"] not in ACTIVE:
            break
        job["state"], job["stage"], job["model"] = cur["state"], cur["stage"], cur["model"]
        trial_only = job["state"] == "trial"
        nxt = con.execute("SELECT doc_id FROM batch_items WHERE job = ? AND state = 'pending'%s ORDER BY trial DESC, doc_id LIMIT 1" % (" AND trial = 1" if trial_only else ""), (jid,)).fetchone()
        if not nxt:
            con.execute("UPDATE batch_jobs SET state = ?, note = NULL, updated_at = ? WHERE id = ? AND state = ?", ("trial_done" if trial_only else "done", now(), jid, job["state"]))
            con.commit()
            break
        try:
            code_one(con, job, fields, nxt[0], "trial" if trial_only else "full")
            refusals = 0
            beat(con, jid)
        except Refused as r:
            refusals += 1
            if refusals > 6:
                con.execute("UPDATE batch_jobs SET state = 'paused', note = ?, updated_at = ? WHERE id = ?", (r.note, now(), jid))
                con.commit()
                break
            beat(con, jid, "Waiting for the go-ahead to reach the model.")
            time.sleep(5)
        except Wait as w:
            beat(con, jid, w.note)
            end = time.time() + w.seconds
            while time.time() < end:
                time.sleep(1)
        except Stop as s:
            con.execute("UPDATE batch_jobs SET state = 'paused', note = ?, updated_at = ? WHERE id = ?", (s.note, now(), jid))
            con.commit()
            break
        except ValueError as e:
            # A document that cannot be coded (the model answered with something unusable twice
            # over, or a 400): marked failed, and the job goes on.
            con.execute("UPDATE batch_items SET state = 'failed', tries = tries + 1, done_at = ? WHERE job = ? AND doc_id = ?", (now(), jid, nxt[0]))
            con.commit()
            sys.stderr.write("ola-batch: document %d failed: %s\n" % (nxt[0], str(e)[:200]))
    stop.set()
    st = con.execute("SELECT state FROM batch_jobs WHERE id = ?", (jid,)).fetchone()
    print(json.dumps({"state": st[0] if st else None}))


# ------------------------------------------------------------------ the command line

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    if cmd == "api":
        return api(rest)
    if cmd == "run" and len(rest) in (1, 2) and rest[1:] in ([], ["--key-stdin"]):
        if rest[1:] == ["--key-stdin"]:
            global RUNNER_KEY
            k = sys.stdin.readline().strip()
            if not re.fullmatch(r"[0-9a-f]{64}", k):
                fail("run --key-stdin: no runner key on the input")
            RUNNER_KEY = k
        return run(rest[0])
    if cmd == "propose" and len(rest) == 1:
        return propose(rest[0])
    if cmd == "list":
        return list_jobs()
    if cmd == "show" and len(rest) == 1:
        return show(rest[0])
    if cmd == "results" and rest:
        lim = int(rest[rest.index("--limit") + 1]) if "--limit" in rest else 50
        return rows(rest[0], "--problems" in rest, max(1, min(lim, 1000)))
    if cmd == "check" and len(rest) == 3:
        return check_cmd(*rest)
    if cmd == "withdraw" and len(rest) == 1:
        return withdraw(rest[0])
    fail("unknown command; see ola-batch --help")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:
        pass
    except sqlite3.Error as e:
        fail("the project database: " + str(e)[:200], 3)
