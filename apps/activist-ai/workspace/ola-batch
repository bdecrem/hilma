        problems INTEGER NOT NULL DEFAULT 0,     -- values whose quote was not found, or answers that could not be used
        done_at TEXT,
        PRIMARY KEY (job, doc_id)
      );
    """)
    return con


# ------------------------------------------------------------------ the quote check
#
# The rule, in full (README, "Batch jobs"): a quote is checked against the document's stored text
# (doc_text, by page) after these changes to BOTH sides, and nothing else:
#   1. Unicode NFKC: ligatures become their letters (U+FB01 "ﬁ" is "fi"), full-width forms plain.
#   2. Soft hyphens (U+00AD) are removed; the other hyphens (U+2010, U+2011) become "-".
#   3. Curly quotes become straight ones (‘ ’ ‚ ‛ to ', “ ” „ ‟ to ").
#   4. A line-break hyphen (a letter, "-", a line break, a letter) is read both ways: joined
#      ("adap-\ntation" is "adaptation") and kept ("long-\nterm" is "long-term"). A quote matches
#      if it is in either reading.
#   5. Every run of white space (spaces, tabs, line breaks) is one space; ends are trimmed.
# Then the quote must appear as one exact, case-sensitive substring. A quote shorter than four
# words, or with an ellipsis, is not checked: it counts as not found. Found on the stated page:
# "found"; found on another page of the same document: "found on another page" (the page is
# corrected); anywhere else: "quote not found".

_QUOTES = str.maketrans({"‘": "'", "’": "'", "‚": "'", "‛": "'", "“": '"', "”": '"', "„": '"', "‟": '"', "‐": "-", "‑": "-"})
_LB_HYPHEN = re.compile(r"(\w)-[ \t]*\r?\n\s*(\w)", re.U)
_WS = re.compile(r"\s+", re.U)


def _base(s):
    s = unicodedata.normalize("NFKC", s or "").replace("­", "").translate(_QUOTES)
    return s


def readings(text):
    """The page's text as it is compared: joined and kept line-break hyphens."""
    b = _base(text)
    joined = _WS.sub(" ", _LB_HYPHEN.sub(r"\1\2", b)).strip()
    kept = _WS.sub(" ", _LB_HYPHEN.sub(r"\1-\2", b)).strip()
    return (joined, kept) if joined != kept else (joined,)


def norm_quote(q):
    return _WS.sub(" ", _LB_HYPHEN.sub(r"\1\2", _base(q))).strip()


def quote_check(pages, quote, page):
    """pages: {page number: text}. Returns (result, page found on or None)."""
    q = norm_quote(quote)
    if len(q.split(" ")) < MIN_QUOTE_WORDS or "..." in q or "…" in quote:
        return "quote not found", None
    order = ([page] if page in pages else []) + [p for p in sorted(pages) if p != page]
    for p in order:
        if any(q in r for r in readings(pages[p])):
            # No page given: found is found, and the page is filled in.
            return ("found" if p == page or page is None else "found on another page"), p
    return "quote not found", None


def doc_pages(con, doc_id):
    return {r["page"]: r["text"] or "" for r in con.execute("SELECT page, text FROM doc_text WHERE doc_id = ? ORDER BY page", (doc_id,))}


# ------------------------------------------------------------------ the form

def clean_spec(spec):
    if not isinstance(spec, dict):
        fail("the spec is a JSON object")
    name = spec.get("name", "")
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{0,40}", name) or name.lower().startswith(("batch_", "sqlite_", "doc_text")) or name.lower() in ("documents", "tables_catalog", "ola_meta"):
        fail("name: the table the answers go to, letters, digits and _, starting with a letter (and not a name Ola keeps)")
    title = spec.get("title", "")
    if not isinstance(title, str) or not 3 <= len(title.strip()) <= 300:
        fail("title: one plain sentence of what is asked (3 to 300 characters)")
    instr = spec.get("instructions") or ""
    if not isinstance(instr, str) or len(instr) > 4000:
        fail("instructions: at most 4,000 characters")
    fields = spec.get("fields")
    if not isinstance(fields, list) or not 1 <= len(fields) <= 25:
        fail("fields: a list of 1 to 25 fields")
    out, seen = [], set()
    for i, f in enumerate(fields):
        if not isinstance(f, dict):
            fail("fields[%d] is an object" % i)
        n = f.get("name", "")
        if not isinstance(n, str) or not re.fullmatch(r"[a-z][a-z0-9_]{0,30}", n) or n in seen or n in ("document", "document_id", "model", "coded_at", "stage", "machine_coded", "checked"):
            fail("fields[%d].name: lowercase letters, digits and _, unique" % i)
        seen.add(n)
        t = f.get("type", "text")
        if t not in TYPES:
            fail("fields[%d].type: one of %s" % (i, ", ".join(TYPES)))
        q = f.get("question", "")
        if not isinstance(q, str) or not 3 <= len(q.strip()) <= 500:
            fail("fields[%d].question: the question for this field" % i)
        g = {"name": n, "type": t, "question": q.strip()}
        if t == "category":
            vals = f.get("values")
            if not isinstance(vals, list) or not 2 <= len(vals) <= 40 or not all(isinstance(v, str) and 0 < len(v.strip()) <= 80 for v in vals):
                fail("fields[%d].values: 2 to 40 short answers to choose from" % i)
            vals = [v.strip() for v in vals if v.strip().lower() != NOT_STATED]
            g["values"] = vals
        out.append(g)
    sel = spec.get("documents", "all")
    if not isinstance(sel, str) or not (sel == "all" or re.match(r"(?is)^\s*select\b", sel)) or len(sel) > 4000:
        fail('documents: "all", or a SELECT that returns document ids')
    trial = spec.get("trial", 15)
    if not isinstance(trial, int) or not 10 <= trial <= 20:
        fail("trial: 10 to 20 documents")
    model = spec.get("model", "general")
    if model not in SPEED:
        fail("model: general (Ola's own), hosted or claude")
    return {"name": name, "title": title.strip(), "instructions": instr.strip(), "fields": out, "selection": sel, "trial": trial, "model": model}


def select_docs(con, sel):
    if sel == "all":
        return [r[0] for r in con.execute("SELECT id FROM documents ORDER BY id")]
    ro = sqlite3.connect("file:" + DB + "?mode=ro", uri=True, timeout=10)
    ro.execute("PRAGMA query_only = 1")
    try:
        cur = ro.execute(sel)
        ids = []
        for r in cur:
            if r and isinstance(r[0], int):
                ids.append(r[0])
    except sqlite3.Error as e:
        fail("documents: the SELECT did not run: " + str(e)[:200], 3)
    have = {r[0] for r in con.execute("SELECT id FROM documents")}
    return sorted({i for i in ids if i in have})


def form_text(job, fields):
    lines = ["The question: " + job["title"]]
    if job["instructions"]:
        lines.append(job["instructions"])
    lines.append("")
    lines.append("The form:")
    example = {}
    for f in fields:
        if f["type"] == "category":
            kind = "one of: " + ", ".join(f["values"]) + ', or "not stated"'
        elif f["type"] == "number":
            kind = 'a number, or "not stated"'
        elif f["type"] == "yesno":
            kind = 'yes or no, or "not stated"'
        else:
            kind = 'a short answer in your own words, or "not stated"'
        lines.append("- %s (%s): %s" % (f["name"], kind, f["question"]))
        example[f["name"]] = {"value": "...", "quote": "...", "page": 1}
    lines.append("")
    lines.append("Answer like this: " + json.dumps(example))
    return "\n".join(lines)


def doc_text_for_model(con, doc_id):
    d = con.execute("SELECT title, unit FROM documents WHERE id = ?", (doc_id,)).fetchone()
    pages = doc_pages(con, doc_id)
    out, total, cut = [], 0, False
    for p in sorted(pages):
        t = pages[p]
        if total + len(t) > MAX_DOC_CHARS:
            t = t[: max(0, MAX_DOC_CHARS - total)]
            cut = True
        out.append("[page %d]\n%s" % (p, t))
        total += len(t)
        if cut:
            break
    head = 'The document: "%s" (%d %s%s)' % ((d["title"] if d else "untitled")[:200], len(pages), (d["unit"] if d else "page"), "" if len(pages) == 1 else "s")
    if cut:
        head += ". Only the beginning is given here; answer from what is given."
    return head + "\n\n" + "\n\n".join(out), total, pages, cut


def doc_chars(con, doc_id):
    r = con.execute("SELECT coalesce(sum(length(text)), 0) FROM doc_text WHERE doc_id = ?", (doc_id,)).fetchone()
    return min(MAX_DOC_CHARS, r[0] or 0)


# ------------------------------------------------------------------ the estimate

_WEEK = []


def weekly(token):
    """This project's week of model use, from the gateway (None if it cannot say); asked once per process."""
    if _WEEK:
        return _WEEK[0]
    out = None
    try:
        r = gw_request("GET", "/v1/usage", None, token, timeout=3)
        if r[0] == 200:
            u = json.loads(r[2])
            if isinstance(u.get("quota"), int):
                out = {"quota": u.get("quota"), "used": u.get("tokens_used")}
    except Exception:
        pass
    _WEEK.append(out)
    return out


def estimate(con, job, fields, ids, measured=None):
    form_tokens = (len(SYSTEM) + len(form_text(job, fields))) // 4 + 60
    out_per = 60 + 70 * len(fields)
    tin = sum(doc_chars(con, i) // 4 + form_tokens for i in ids)
    tout = out_per * len(ids)
    # A retry for one document in ten, on average (a quote not found, an answer out of shape).
    tin, tout = int(tin * 1.1), int(tout * 1.1)
    pin, pout = SPEED.get(job["model"], SPEED["general"])
    secs = tin / pin + tout / pout
    basis = "estimate"
    if measured and measured.get("docs"):
        per_tok = measured["tokens"] / measured["docs"]
        per_sec = measured["ms"] / 1000 / measured["docs"]
        n = len(ids)
        tin_tout = per_tok * n
        frac_in = measured["tokens_in"] / max(1, measured["tokens"])
        tin, tout = int(tin_tout * frac_in), int(tin_tout * (1 - frac_in))
        secs = per_sec * n
        basis = "measured in the trial"
    w = weekly(os.environ.get("BOX_API_KEY", ""))
    total = tin + tout
    return {"documents": len(ids), "tokens_in": tin, "tokens_out": tout, "tokens": total, "seconds": int(secs), "basis": basis,
            "budget": int(total * 1.3) + 10000, "week_quota": (w or {}).get("quota"), "week_used": (w or {}).get("used"),
            "week_share": (total / w["quota"]) if w and w.get("quota") else None}


# ------------------------------------------------------------------ commands for the agent

def job_row(con, jid):
    if not isinstance(jid, str) or not re.fullmatch(r"[0-9a-f]{12}", jid):
        fail("a job id is 12 letters and digits (ola-batch list shows them)")
    r = con.execute("SELECT * FROM batch_jobs WHERE id = ?", (jid,)).fetchone()
    if not r:
        fail("no such job: " + jid, 4)
    return r


def propose(path):
    full = os.path.realpath(path if path.startswith("/") else os.path.join(os.getcwd(), path))
    try:
        with open(full, "r", encoding="utf-8") as f:
            spec = json.load(f)
    except (OSError, ValueError) as e:
        fail("the spec could not be read as JSON: " + str(e)[:200])
    s = clean_spec(spec)
    con = connect()
    ids = select_docs(con, s["selection"])
    if not ids:
        fail("no documents match; see them with: ola-db query \"SELECT id, title FROM documents\"", 3)
    name, i = s["name"], 2
    taken = {r[0] for r in con.execute("SELECT name FROM sqlite_master")} | {r[0] for r in con.execute("SELECT name FROM batch_jobs")}
    while name in taken:
        name, i = "%s_%d" % (s["name"], i), i + 1
    jid = secrets.token_hex(6)
    job = {"title": s["title"], "instructions": s["instructions"], "model": s["model"]}
    est = estimate(con, job, s["fields"], ids)
    t = now()
    con.execute("INSERT INTO batch_jobs (id, name, title, instructions, fields, selection, model, trial_size, state, stage, estimate, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'proposed', 'trial', ?, ?, ?)",
                (jid, name, s["title"], s["instructions"], json.dumps(s["fields"]), s["selection"], s["model"], s["trial"], json.dumps(est), t, t))
    # The trial: documents chosen at random (seeded by the job, so it is the same every time).
    trial = set(random.Random(jid).sample(ids, min(s["trial"], len(ids))))
    con.executemany("INSERT INTO batch_items (job, doc_id, trial) VALUES (?, ?, ?)", [(jid, d, 1 if d in trial else 0) for d in ids])
    con.commit()
    print("Proposed job %s: %s" % (jid, s["title"]))
    print("%d documents; about %s tokens (%s); about %s on Ola's computer." % (len(ids), f"{est['tokens']:,}", est["basis"], human_time(est["seconds"])))
    if est["week_share"] is not None:
        share = "less than 1%" if est["week_share"] < 0.01 else "about %d%%" % round(est["week_share"] * 100)
        print("That is %s of a week of this project's model use; it runs on a budget of its own (%s tokens), so conversations keep theirs." % (share, f"{est['budget']:,}"))
    print("The answers will go to the table %s, one row per document, each value with its quote and page, every quote checked." % name)
    print("It does not run yet. Tell the person: under Jobs they can look at it and start a trial on %d documents; they see those rows before the whole job runs." % len(trial))


def human_time(s):
    s = int(s)
    if s < 90:
        return "a minute or two"
    if s < 3600:
        return "%d minutes" % round(s / 60)
    if s < 48 * 3600:
        h = s / 3600
        return ("%.1f hours" % h).replace(".0 ", " ") if h < 10 else "%d hours" % round(h)
    return "%.1f days" % (s / 86400)


def progress(con, jid):
    out = {"pending": 0, "done": 0, "failed": 0, "no_text": 0, "problems": 0, "trial_total": 0, "trial_left": 0, "total": 0, "tokens": 0, "ms": 0, "timed": 0}
    for r in con.execute("SELECT state, trial, problems, tokens_in + tokens_out AS tok, ms FROM batch_items WHERE job = ?", (jid,)):
        out["total"] += 1
        out[r["state"]] = out.get(r["state"], 0) + 1
        out["problems"] += 1 if r["problems"] else 0
        out["tokens"] += r["tok"] or 0
        if r["trial"]:
            out["trial_total"] += 1
            out["trial_left"] += 1 if r["state"] == "pending" else 0
        if r["ms"] and r["state"] in ("done", "failed"):
            out["ms"] += r["ms"]
            out["timed"] += 1
    return out


def measured(con, jid):
    r = con.execute("SELECT count(*) AS n, coalesce(sum(tokens_in), 0) AS tin, coalesce(sum(tokens_out), 0) AS tout, coalesce(sum(ms), 0) AS ms FROM batch_items WHERE job = ? AND state IN ('done', 'failed') AND ms IS NOT NULL", (jid,)).fetchone()
    return {"docs": r["n"], "tokens_in": r["tin"], "tokens": r["tin"] + r["tout"], "ms": r["ms"]}


def job_json(con, r):
    p = progress(con, r["id"])
    left = p["pending"] if r["state"] not in ("trial",) else p["trial_left"]
    per = (p["ms"] / p["timed"] / 1000) if p["timed"] else None
    est = json.loads(r["estimate"] or "{}")
    full_est = None
    if r["state"] in ("trial_done", "running", "paused") and p["timed"]:
        ids = [x[0] for x in con.execute("SELECT doc_id FROM batch_items WHERE job = ? AND state = 'pending'", (r["id"],))]
        full_est = estimate(con, {"title": r["title"], "instructions": r["instructions"], "model": r["model"]}, json.loads(r["fields"]), ids, measured(con, r["id"]))
    beat = r["heartbeat_at"]
    return {"id": r["id"], "name": r["name"], "title": r["title"], "instructions": r["instructions"], "fields": json.loads(r["fields"]),
            "model": r["model"], "state": r["state"], "stage": r["stage"], "trialSize": r["trial_size"], "budget": r["budget"],
            "estimate": est, "remainingEstimate": full_est, "note": r["note"], "created": r["created_at"], "updated": r["updated_at"],
            "heartbeatAge": (time.time() - beat) if beat else None, "progress": p,
            "secondsLeft": int(per * left) if per is not None and r["state"] in ACTIVE + ("paused",) else None}


def list_jobs():
    con = connect()
    rows = con.execute("SELECT * FROM batch_jobs WHERE state != 'withdrawn' ORDER BY created_at DESC LIMIT 50").fetchall()
    if not rows:
        print("No jobs yet. Write a spec and run: ola-batch propose spec.json (ola-batch --help shows the spec).")
    for r in rows:
        j = job_json(con, r)
        p = j["progress"]
        print("- %s  %s  [%s]  %d of %d documents done, %d failed, %d with a problem; table %s" % (r["id"], r["title"], r["state"], p["done"] + p["no_text"], p["total"], p["failed"], p["problems"], r["name"]))


def show(jid):
    con = connect()
    r = job_row(con, jid)
    j = job_json(con, r)
    p = j["progress"]
    print("Job %s: %s  [%s]" % (jid, r["title"], r["state"]))
    print("Model: %s. Table: %s. Documents: %d (trial %d)." % (r["model"], r["name"], p["total"], p["trial_total"]))
    for f in j["fields"]:
        print("  - %s (%s): %s%s" % (f["name"], f["type"], f["question"], " [" + ", ".join(f["values"]) + "]" if f.get("values") else ""))
    print("Done %d, no text %d, failed %d, waiting %d; %d documents have a value whose quote was not found or an answer that could not be used." % (p["done"], p["no_text"], p["failed"], p["pending"], p["problems"]))
    if r["note"]:
        print("Note: " + r["note"])
    rows(jid, False, 5)


def rows(jid, problems_only, limit):
    con = connect()
    r = job_row(con, jid)
    fields = json.loads(r["fields"])
    if not con.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (r["name"],)).fetchone():
        print("No rows yet.")
        return
    where = " WHERE checked != 'all quotes found'" if problems_only else ""
    for x in con.execute("SELECT * FROM %s%s ORDER BY document_id LIMIT ?" % (qi(r["name"]), where), (limit,)):
        print("\n%s (document %d): %s" % (x["document"], x["document_id"], x["checked"]))
        for f in fields:
            n = f["name"]
