def api(argv):
    sub = argv[0] if argv else ""
    opt = {}
    i = 1
    while i < len(argv):
        if argv[i].startswith("--") and i + 1 < len(argv):
            opt[argv[i][2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    con = connect()
    if sub == "list":
        out = [job_json(con, r) for r in con.execute("SELECT * FROM batch_jobs WHERE state != 'withdrawn' ORDER BY created_at DESC LIMIT 50")]
        for j in out:
            j.pop("instructions", None)
        print(json.dumps({"jobs": out}))
    elif sub in ("show", "status"):
        r = job_row(con, opt.get("job", ""))
        j = job_json(con, r)
        if sub == "status":
            print(json.dumps({k: j[k] for k in ("id", "state", "stage", "model", "budget", "note", "heartbeatAge", "progress", "secondsLeft", "estimate", "trialSize")}))
            return
        stage = opt.get("stage")
        offset = max(0, int(opt.get("offset", 0)))
        limit = min(200, max(1, int(opt.get("limit", 50))))
        res = {"columns": [], "rows": [], "total": 0, "offset": offset}
        if con.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (r["name"],)).fetchone():
            where, params = "", []
            if stage in ("trial", "full"):
                where, params = " WHERE stage = ?", [stage]
            if opt.get("problems") == "1":
                where += (" AND " if where else " WHERE ") + "checked != 'all quotes found'"
            cur = con.execute("SELECT * FROM %s%s ORDER BY document_id LIMIT ? OFFSET ?" % (qi(r["name"]), where), params + [limit, offset])
            res["columns"] = [d[0] for d in cur.description]
            res["rows"] = [list(x) for x in cur.fetchall()]
            res["total"] = con.execute("SELECT count(*) FROM %s%s" % (qi(r["name"]), where), params).fetchone()[0]
        j["results"] = res
        print(json.dumps(j, default=str))
    elif sub == "set":
        r = job_row(con, opt.get("job", ""))
        st = opt.get("state")
        if st not in ("trial", "running", "paused", "cancelled"):
            fail("api set: --state trial, running, paused or cancelled")
        sets, params = ["state = ?", "updated_at = ?"], [st, now()]
        if st == "trial":
            sets.append("stage = 'trial'")
        if st == "running":
            sets.append("stage = 'full'")
        if "budget" in opt:
            b = int(opt["budget"])
            if not 1 <= b <= 10 ** 12:
                fail("api set: --budget is a number of tokens")
            sets.append("budget = ?")
            params.append(b)
        if "model" in opt:
            if opt["model"] not in SPEED:
                fail("api set: --model general, hosted or claude")
            sets.append("model = ?")
            params.append(opt["model"])
        sets.append("note = ?")
        params.append(opt.get("note") or None)
        con.execute("UPDATE batch_jobs SET %s WHERE id = ?" % ", ".join(sets), params + [r["id"]])
        con.commit()
        print(json.dumps(job_json(con, job_row(con, r["id"]))))
    else:
        fail("api: list, show, status or set")


