        rows = con.execute(
            """SELECT d.id, d.title, d.path, d.source_url, d.fetched_at, d.unit, t.page, snippet(doc_text, 0, ?, ?, ' … ', 40) AS snip,
                      coalesce(p.method, 'text') AS method, p.confidence AS confidence
               FROM doc_text t JOIN documents d ON d.id = t.doc_id LEFT JOIN doc_pages p ON p.doc_id = d.id AND p.page = t.page
               WHERE doc_text MATCH ? ORDER BY bm25(doc_text) LIMIT ? OFFSET ?""",
