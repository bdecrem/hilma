#!/usr/bin/python3 -I
"""ola-db: the project's database, /work/project.db (SQLite, WAL), one per project.

For the agent (and the person, through it):
  ola-db query "<sql>"               read-only; prints a table (--json for JSON, --limit N rows)
  ola-db query --write "<sql>"       change it (create a table, insert, update); one or more statements
  ola-db load <file> --table <name> [--note "what it holds"] [--replace | --append] [--sheet <name>]
                                     a CSV, TSV, Excel (.xlsx) or JSON file into a named table
  ola-db search "<words>" [--limit N] [--json]
                                     full-text search over every document; each hit names its page
  ola-db add <path> [--source <address>] [--fetched <date>] [--title <title>] [--by upload|web|agent]
             [--charset <name>] [--lang <code>] [--ocr auto|off|force] [--ocr-lang eng+spa]
             [--expect-title "..."] [--expect-doi 10.x/y] [--expect-authors "A; B"] [--expect-cite "..."]
                                     record a document (PDF, page, text, Word, PowerPoint) and index its
                                     text, page by page in reading order; scanned pages are read by OCR
  ola-db add-folder <folder> [--by upload] [--ocr auto|off]
                                     every document in a folder (a library unpacked from a zip)
  ola-db check <path> [--title "..."] [--doi 10.x/y] [--authors "A; B"] [--cite "a citation"]
                                     is this file the document it should be? (title, DOI, authors on its first pages)
  ola-db attach <file.db> [--as <name>]
                                     a SQLite database the person brought: checked, then readable as
                                     <name>.<table> (read-only; it is never changed)
  ola-db remove <path>               forget a document (its row and its index entries)
  ola-db tables                      what is in the database: every table, its rows, where it came from
  ola-db describe <table>            a table's columns and three rows

For the front desk, through `container exec` (always read-only, JSON out, bounded):
  ola-db api tables | browse --table T [--offset N --limit N --sort C --dir asc|desc --q words]
             | docs [--q words --offset N --limit N] | backup | xlsx --table T | disk
  ola-db init                        create what is missing (run at every start by ola-init)

The fixed core: `documents` (one row per document), `doc_text` (FTS5, one row per page or part,
so a hit can cite a page), `doc_pages` (how each page's text was got: from the file's own text, or
by OCR from a scan with the OCR's confidence, so a quote from an OCR page is known to be less
certain), `tables_catalog` (every other table: what it holds, where it came from, when) and
`attached` (databases the person brought, read-only). Everything else is the agent's to add.
Text is cleaned and decoded by /opt/ola/lib/olatext.py, the functions a quote check uses too.
Text that came from the web or a file is data: nothing here runs it.
"""
import csv, datetime, hashlib, html.parser, io, json, os, re, shutil, sqlite3, subprocess, sys, tempfile, time, urllib.parse, zipfile

# In the image: /opt/ola/lib. On a developer machine (web/dev.mjs runs these tools on a folder): ./lib.
sys.path.insert(0, os.environ.get("OLA_LIB") or ("/opt/ola/lib" if os.path.isdir("/opt/ola/lib") else os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib")))
from olatext import clean, decode_bytes, match_key  # noqa: E402  the one shared cleaner (see its docstring)

WORK = os.environ.get("OLA_WORK", "/work")
DB = os.path.join(WORK, "project.db")
TMP = os.path.join(WORK, ".ola", "tmp")

def capped(timeout):
    """Limits for a program that reads someone else's file (poppler, Tesseract): its memory
    (OLA_TOOL_MEM_MB, 1536 MiB of address space), its CPU time (the timeout and a little) and the
    size of a file it may write (512 MiB), so a hostile PDF or picture cannot take the whole
    computer's memory and get opencode killed in its place (review 5 follow-up). Linux only."""
    def f():
        try:
            import resource
            mem = int(os.environ.get("OLA_TOOL_MEM_MB", "1536")) << 20
            resource.setrlimit(resource.RLIMIT_AS, (mem, mem))
            resource.setrlimit(resource.RLIMIT_CPU, (int(timeout) + 5, int(timeout) + 10))
            resource.setrlimit(resource.RLIMIT_FSIZE, (512 << 20, 512 << 20))
        except (ImportError, ValueError, OSError):
            pass
    return f if sys.platform.startswith("linux") else None

# batch_jobs and batch_items are ola-batch's own bookkeeping (its answers go to named tables).
CORE = {"documents", "doc_text", "tables_catalog", "ola_meta", "batch_jobs", "batch_items", "doc_pages", "attached"}
SCHEMA_VERSION = "2"
DOC_TYPES = {".pdf": "application/pdf", ".txt": "text/plain", ".md": "text/markdown", ".html": "text/html", ".htm": "text/html",
             ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
             ".pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
             ".odt": "application/vnd.oasis.opendocument.text", ".xml": "application/xml", ".json": "application/json", ".rtf": "application/rtf"}
DOC_EXT = (".pdf", ".txt", ".md", ".html", ".htm", ".docx", ".pptx", ".odt", ".rtf")
PART_CHARS = 4000
MAX_TEXT = 40 * 1024 * 1024  # characters indexed from one document
MAX_UNZIPPED = 64 * 1024 * 1024  # bytes read from one part of an office file (no zip bombs)
# A page with fewer characters than this, and a picture on it, is a scan: it is read by OCR.
SCAN_CHARS = 40
MAX_OCR_PAGES = int(os.environ.get("OLA_MAX_OCR_PAGES", "400"))
# Which Tesseract languages read a page, by the script Tesseract sees on it (its OSD). Latin script
# gets the European languages the first projects need; Norwegian (nor) and Filipino (fil) are
# installed too, for --ocr-lang. All of them are Debian's tesseract-ocr-* packs (the "fast" models).
OCR_LANGS = {"Latin": "eng+spa+fra+por+deu", "Cyrillic": "rus+eng", "Arabic": "ara", "Hebrew": "heb", "Han": "chi_sim+chi_tra", "Greek": "eng"}


def fail(msg, code=2):
    sys.stderr.write("ola-db: " + msg + "\n")
    sys.exit(code)


def now():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def uri(path, mode=None):
    return "file:" + urllib.parse.quote(path) + ("?mode=" + mode if mode else "")


def connect(write, attach=True):
    if write:
        if not os.path.exists(DB):
            init()
        con = sqlite3.connect(uri(DB), uri=True, timeout=10)
        con.execute("PRAGMA journal_mode = WAL")
        con.execute("PRAGMA busy_timeout = 10000")
    else:
        if not os.path.exists(DB):
            init()
        con = sqlite3.connect(uri(DB, "ro"), uri=True, timeout=10)
        con.execute("PRAGMA query_only = 1")
    # A database the person brought is someone else's file: its views and triggers may not call
    # functions with side effects (load_extension and the like), and a damaged page is caught.
    con.execute("PRAGMA trusted_schema = OFF")
    con.execute("PRAGMA cell_size_check = ON")
    con.row_factory = sqlite3.Row
    if attach:
        for alias, path in attachments(con):
            full = os.path.join(WORK, path)
            if os.path.isfile(full) and not os.path.islink(full):
                try:
                    con.execute("ATTACH DATABASE ? AS " + qi(alias), (uri(full, "ro"),))
                except sqlite3.Error:
                    pass
    return con


def attachments(con):
    try:
        return [(r[0], r[1]) for r in con.execute("SELECT alias, path FROM main.attached ORDER BY alias")]
    except sqlite3.Error:
        return []


def init():
    con = sqlite3.connect(DB, timeout=10)
    con.execute("PRAGMA journal_mode = WAL")
    con.executescript("""
      CREATE TABLE IF NOT EXISTS ola_meta (key TEXT PRIMARY KEY, value TEXT);
      CREATE TABLE IF NOT EXISTS documents (
        id INTEGER PRIMARY KEY,
        title TEXT,
        source_url TEXT,                 -- where it came from on the web (NULL for an upload)
        fetched_at TEXT,                 -- when it was downloaded (UTC, ISO 8601)
        path TEXT NOT NULL UNIQUE,       -- the file, relative to /work
        sha256 TEXT,
        mime TEXT,
        pages INTEGER,                   -- pages (PDF, slides) or parts of about 4,000 characters
        unit TEXT NOT NULL DEFAULT 'page' CHECK (unit IN ('page', 'slide', 'part')),
        chars INTEGER,
        added_by TEXT NOT NULL CHECK (added_by IN ('upload', 'web', 'agent')),
        added_at TEXT NOT NULL
      );
      CREATE VIRTUAL TABLE IF NOT EXISTS doc_text USING fts5(text, doc_id UNINDEXED, page UNINDEXED, tokenize = 'porter unicode61 remove_diacritics 2');
      CREATE TABLE IF NOT EXISTS tables_catalog (
        name TEXT PRIMARY KEY,
        description TEXT,                -- what it holds, in a sentence
        source TEXT,                     -- the file it was loaded from, or 'made by Ola'
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
      );
      CREATE TABLE IF NOT EXISTS doc_pages (
        doc_id INTEGER NOT NULL,
        page INTEGER NOT NULL,
        method TEXT NOT NULL CHECK (method IN ('text', 'ocr', 'ocr-model', 'empty')),  -- ocr: read from a scan, may have errors
        confidence REAL,                 -- the OCR's own mean word confidence, 0 to 100
        lang TEXT,                       -- the OCR languages used
        PRIMARY KEY (doc_id, page)
      );
      CREATE TABLE IF NOT EXISTS attached (
        alias TEXT PRIMARY KEY,          -- its tables are read as <alias>.<table>
        path TEXT NOT NULL UNIQUE,       -- the file, relative to /work
        sha256 TEXT, size INTEGER, tables INTEGER,
        checked_at TEXT NOT NULL
      );
    """)
    have = {r[1] for r in con.execute("SELECT * FROM pragma_table_info('documents')")}
    # Schema 2 (2026-11-17): OCR pages, the right-document check and what was expected.
    for col, decl in (("ocr_pages", "INTEGER NOT NULL DEFAULT 0"), ("check_result", "TEXT"), ("check_detail", "TEXT"), ("expect", "TEXT")):
        if col not in have:
            con.execute("ALTER TABLE documents ADD COLUMN %s %s" % (col, decl))
    con.execute("INSERT OR REPLACE INTO ola_meta (key, value) VALUES ('schema', ?)", (SCHEMA_VERSION,))
    # A document whose file is gone (deleted from Files, or by the agent) is forgotten.
    for row in con.execute("SELECT id, path FROM documents").fetchall():
        if not os.path.isfile(os.path.join(WORK, row[1])):
            forget(con, row[0])
    for alias, path in attachments(con):
        if not os.path.isfile(os.path.join(WORK, path)):
            con.execute("DELETE FROM attached WHERE alias = ?", (alias,))
    sync_catalog(con)
    con.commit()
    con.close()
    try:
        os.chmod(DB, 0o600)
    except OSError:
        pass


def forget(con, doc_id):
    con.execute("DELETE FROM doc_text WHERE doc_id = ?", (doc_id,))
    con.execute("DELETE FROM doc_pages WHERE doc_id = ?", (doc_id,))
    con.execute("DELETE FROM documents WHERE id = ?", (doc_id,))


def user_tables(con):
    out = []
    for r in con.execute("SELECT name, type FROM main.sqlite_master WHERE type IN ('table', 'view') ORDER BY name"):
        n = r[0]
        if n in CORE or n.startswith("sqlite_") or n.startswith("doc_text_"):
            continue
        out.append((n, r[1]))
    return out


def attached_tables(con):
    """(alias.table, kind) for every table and view of every attached database."""
    out = []
    for alias, _ in attachments(con):
        try:
            for r in con.execute("SELECT name, type FROM %s.sqlite_master WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%%' ORDER BY name" % qi(alias)):
                out.append((alias + "." + r[0], r[1]))
        except sqlite3.Error:
            pass
    return out


def sync_catalog(con):
    have = {n for n, _ in user_tables(con)}
    listed = {r[0] for r in con.execute("SELECT name FROM tables_catalog")}
    t = now()
    for n in have - listed:
        con.execute("INSERT INTO tables_catalog (name, description, source, created_at, updated_at) VALUES (?, NULL, 'made by Ola', ?, ?)", (n, t, t))
    for n in listed - have:
        con.execute("DELETE FROM tables_catalog WHERE name = ?", (n,))


def qi(name):
    return '"' + name.replace('"', '""') + '"'


def split_name(con, name):
    """'alias.table' of an attached database -> (alias, table); anything else -> ('main', name)."""
    if "." in name:
        alias, rest = name.split(".", 1)
        if alias in {a for a, _ in attachments(con)}:
            return alias, rest
    return "main", name


def qt(con, name):
    alias, t = split_name(con, name)
    return qi(t) if alias == "main" else qi(alias) + "." + qi(t)


def columns(con, table):
    alias, t = split_name(con, table)
    return [(r[1], r[2] or "") for r in con.execute("SELECT * FROM pragma_table_info(?, ?)", (t, alias))]


def deadline(con, seconds):
    end = time.monotonic() + seconds
    con.set_progress_handler(lambda: 1 if time.monotonic() > end else 0, 10000)


# ------------------------------------------------------------------ text from documents

class _Text(html.parser.HTMLParser):
    SKIP = {"script", "style", "noscript", "template", "svg", "head"}
    BLOCK = {"p", "div", "br", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6", "section", "article", "table", "pre", "blockquote", "dd", "dt"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip, self.title, self.in_title = [], 0, "", False

    def handle_starttag(self, tag, attrs):
        if tag == "title":
            self.in_title = True
        if tag in self.SKIP:
            self.skip += 1
        if tag in self.BLOCK:
            self.out.append("\n")

    def handle_endtag(self, tag):
        if tag == "title":
            self.in_title = False
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        if tag in self.BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        if self.in_title:
            self.title += data
        elif not self.skip:
            self.out.append(data)


def html_text(raw):
    p = _Text()
    p.feed(raw)
    text = re.sub(r"[ \t\r\f\v]+", " ", "".join(p.out))
    text = re.sub(r"\n\s*\n+", "\n\n", text).strip()
    return re.sub(r"\s+", " ", p.title).strip() or None, text


def decode(data, declared=None, lang=None):
    """Bytes to text: the declared charset first, then UTF-8, UTF-16, the language's code page
    (olatext.decode_bytes; before 2026-11-17 a declared charset was ignored, so a Windows-1255
    Hebrew page came out as Windows-1252 garble)."""
    return decode_bytes(data, declared, lang)[0]


def parts(text):
    """Splits long text into parts of about PART_CHARS characters, at paragraph or line ends."""
    out, cur = [], ""
    for para in re.split(r"(\n\n+)", text):
        if len(cur) + len(para) > PART_CHARS and cur.strip():
            out.append(cur.strip())
            cur = ""
        while len(para) > PART_CHARS * 2:
            out.append(para[:PART_CHARS])
            para = para[PART_CHARS:]
        cur += para
    if cur.strip():
        out.append(cur.strip())
    return out or [""]


def zip_part(z, name):
    info = z.getinfo(name)
    if info.file_size > MAX_UNZIPPED:
        raise ValueError("a part of the file is too large to open")
    with z.open(info) as f:
        return f.read(MAX_UNZIPPED + 1)[:MAX_UNZIPPED].decode("utf-8", "replace")


def xml_paras(xml, para_tag, text_tag):
    out = []
    for p in re.findall(r"<%s[ >].*?</%s>" % (para_tag, para_tag), xml, re.S):
        bits = re.findall(r"<%s(?: [^>]*)?>([^<]*)</%s>" % (text_tag, text_tag), p)
        out.append(_unescape("".join(bits)))
    return "\n".join(x for x in out if x.strip())


def _unescape(s):
    return s.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&apos;", "'").replace("&amp;", "&")


def run(args, timeout, **kw):
    return subprocess.run(args, capture_output=True, timeout=timeout, preexec_fn=capped(timeout), **kw)


def pdf_image_pages(full):
    """The pages that have a picture on them (pdfimages -list), as a set of page numbers."""
    try:
        r = run(["pdfimages", "-list", full], 120)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    pages = set()
    for line in r.stdout.decode("utf-8", "replace").splitlines()[2:]:
        f = line.split()
        if f and f[0].isdigit():
            pages.add(int(f[0]))
    return pages


def tesseract_langs():
    try:
        out = run(["tesseract", "--list-langs"], 30).stdout.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired):
        return set()
    return {l.strip() for l in out.splitlines()[1:] if l.strip()}


def ocr_page(full, n, lang=None):
    """(text, confidence, langs, method) for page n of a PDF, read from its picture.

    The local engine is Tesseract, inside this sealed computer. Where a model would read the page
    instead: with OLA_OCR_ENGINE=model and an `ola-ocr` command in the image (a vision model
    reached through the gateway, built separately), the page image is handed to `ola-ocr <png>`
    here, its text on stdout, and the page is marked 'ocr-model'. When that command is missing or
    fails, Tesseract reads it. Either way the page is marked as OCR, so a reader knows the text
    may have errors."""
    with tempfile.TemporaryDirectory(prefix="ola-ocr-") as d:
        r = run(["pdftoppm", "-f", str(n), "-l", str(n), "-r", "300", "-gray", "-png", "-singlefile", full, os.path.join(d, "p")], 180)
        img = os.path.join(d, "p.png")
        if r.returncode != 0 or not os.path.isfile(img):
            return "", None, None, "empty"
        if os.environ.get("OLA_OCR_ENGINE") == "model" and shutil.which("ola-ocr"):
            try:
                m = run(["ola-ocr", img], 300)
                if m.returncode == 0 and m.stdout.strip():
                    return clean(m.stdout.decode("utf-8", "replace")), None, "model", "ocr-model"
            except (OSError, subprocess.TimeoutExpired):
                pass
        have = tesseract_langs()
        if not have:
            return "", None, None, "empty"
        langs = lang
        if not langs:
            osd = run(["tesseract", img, "-", "--psm", "0"], 120).stdout.decode("utf-8", "replace")
            m = re.search(r"^Script:\s*(\w+)", osd, re.M)
            langs = OCR_LANGS.get(m.group(1) if m else "Latin", "eng")
        langs = "+".join(l for l in langs.split("+") if l in have) or "eng"
        r = run(["tesseract", img, os.path.join(d, "out"), "-l", langs, "--psm", "3", "txt", "tsv"], 600, env={**os.environ, "OMP_THREAD_LIMIT": "2"})
        try:
            text = open(os.path.join(d, "out.txt"), encoding="utf-8", errors="replace").read()
        except OSError:
            return "", None, langs, "empty"
        confs = []
        try:
            for row in open(os.path.join(d, "out.tsv"), encoding="utf-8", errors="replace").read().splitlines()[1:]:
                f = row.split("\t")
                if len(f) >= 12 and f[11].strip():
                    try:
                        c = float(f[10])
                    except ValueError:
                        continue
                    if c >= 0:
                        confs.append(c)
        except OSError:
            pass
        conf = round(sum(confs) / len(confs), 1) if confs else None
        return clean(text), conf, langs, "ocr"


def pdf_pages(full, ocr="auto", ocr_lang=None):
    """(title, [page texts], [(method, confidence, langs)]) for a PDF, page by page in reading order.

    Reading order: poppler's default mode, not -layout. Measured 2026-11-17 on the made-up papers
    of testdata/mkdocs.py (testdata/measure-order.py): of 14 sentences in a two-column paper,
    -layout kept 0 whole (it sets the two columns side by side on each line), the default mode 14,
    -raw 14; a one-column paper 7 of 7 in every mode."""
    if not shutil.which("pdftotext"):
        fail("pdftotext is not installed here", 5)
    r = run(["pdftotext", "-enc", "UTF-8", full, "-"], 300)
    pages = r.stdout.decode("utf-8", "replace").split("\f")
    if pages and not pages[-1].strip():
        pages = pages[:-1]
    title = None
    count = len(pages)
    if shutil.which("pdfinfo"):
        info = run(["pdfinfo", full], 60).stdout.decode("utf-8", "replace")
        m = re.search(r"^Title:\s*(.+)$", info, re.M)
        title = m.group(1).strip() if m and m.group(1).strip() else None
        m = re.search(r"^Pages:\s*(\d+)", info, re.M)
        if m:
            count = int(m.group(1))
    while len(pages) < count:
        pages.append("")
    pages = [clean(p) for p in pages] or [""]
    methods = [("text" if p else "empty", None, None) for p in pages]
    if ocr != "off" and shutil.which("tesseract"):
        thin = [i for i, p in enumerate(pages) if len(p) < SCAN_CHARS or ocr == "force"]
        if thin:
            pictured = pdf_image_pages(full) if ocr != "force" else set(range(1, len(pages) + 1))
            done = 0
            for i in thin:
                if i + 1 not in pictured or done >= MAX_OCR_PAGES:
                    continue
                done += 1
                text, conf, langs, method = ocr_page(full, i + 1, ocr_lang)
                if text and len(text) > len(pages[i]):
                    pages[i] = text
                    methods[i] = (method, conf, langs)
    return title, pages, methods


def extract(full, mime, charset=None, lang=None, ocr="auto", ocr_lang=None):
    """(title, [page texts], unit, [(method, confidence, langs)] or None) for a document file."""
    ext = os.path.splitext(full)[1].lower()
    if ext == ".pdf" or mime == "application/pdf":
        title, pages, methods = pdf_pages(full, ocr, ocr_lang)
        return title, pages, "page", methods
    if ext in (".docx", ".odt", ".pptx"):
        with zipfile.ZipFile(full) as z:
            if ext == ".docx":
                return None, parts(clean(xml_paras(zip_part(z, "word/document.xml"), "w:p", "w:t"))), "part", None
            if ext == ".odt":
                xml = zip_part(z, "content.xml")
                text = _unescape(re.sub(r"<[^>]+>", "", re.sub(r"</text:(p|h)>", "\n", xml)))
                return None, parts(clean(text)), "part", None
            slides = sorted((n for n in z.namelist() if re.fullmatch(r"ppt/slides/slide\d+\.xml", n)), key=lambda n: int(re.search(r"\d+", n.split("/")[-1]).group()))
            return None, [clean(xml_paras(zip_part(z, n), "a:p", "a:t")) for n in slides[:2000]] or [""], "slide", None
    with open(full, "rb") as f:
        raw = decode(f.read(MAX_TEXT), charset, lang)
    if ext in (".html", ".htm") or (mime or "").startswith("text/html") or (mime or "") == "application/xhtml+xml":
        title, text = html_text(raw)
        return title, parts(clean(text)), "part", None
    if ext == ".rtf":
        raw = re.sub(r"\\[a-z]+-?\d* ?|[{}]", "", raw)
    return None, parts(clean(raw)), "part", None


def sha_of(full):
    h = hashlib.sha256()
    with open(full, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def rel_path(p):
    full = os.path.realpath(os.path.join(WORK, p) if not p.startswith("/") else p)
    if not full.startswith(os.path.realpath(WORK) + "/"):
        fail("the file must be inside the project folder")
    return full, os.path.relpath(full, os.path.realpath(WORK))


def add(path, source=None, fetched=None, title=None, by="agent", mime=None, quiet=False, charset=None, lang=None, ocr="auto", ocr_lang=None, expect=None):
    full, rel = rel_path(path)
    if not os.path.isfile(full):
        fail("no such file: " + rel, 4)
    mime = mime or DOC_TYPES.get(os.path.splitext(full)[1].lower()) or "text/plain"
    found_title, pages, unit, methods = extract(full, mime, charset, lang, ocr, ocr_lang)
    total = 0
    kept = []
    for p in pages:
        p = p[: max(0, MAX_TEXT - total)]
        total += len(p)
        kept.append(p)
    ocr_pages = sum(1 for m in (methods or []) if m[0].startswith("ocr"))
