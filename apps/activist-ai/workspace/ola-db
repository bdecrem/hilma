def fts_query(words_, any_word=False):
    toks = re.findall(r"[\w'-]+", words_, re.U)
    toks = [t.replace('"', "") for t in toks if t.strip("'-")][:40]
    if not toks:
        return None
    return (" OR " if any_word else " ").join('"%s"' % t for t in toks)


def search(words_, limit, offset=0, mark=("[", "]")):
    con = connect(False, attach=False)
