def add_folder(folder, by, ocr):
    """Every document under a folder, one JSON line each, then a summary. One failure stops nothing."""
    full, rel = rel_path(folder)
    if not os.path.isdir(full):
        fail("no such folder: " + rel, 4)
    n = ok = ocr_total = 0
    for root, dirs, files in os.walk(full):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and not os.path.islink(os.path.join(root, d)))
        for f in sorted(files):
            p = os.path.join(root, f)
            if f.startswith(".") or os.path.islink(p) or not f.lower().endswith(DOC_EXT):
                continue
            n += 1
            r = os.path.relpath(p, os.path.realpath(WORK))
