            except Exception as e:  # a damaged file is noted, the rest go on
                print(json.dumps({"path": r, "ok": False, "why": type(e).__name__}), flush=True)
    print(json.dumps({"done": True, "documents": n, "indexed": ok, "ocr_pages": ocr_total}))


