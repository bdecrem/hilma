def attach(path, alias):
    full, rel = rel_path(path)
    if not os.path.isfile(full) or os.path.islink(full):
        fail("no such file: " + rel, 4)
    with open(full, "rb") as f:
        if f.read(16) != b"SQLite format 3\x00":
            fail("%s is not a SQLite database" % rel, 3)
    alias = alias or re.sub(r"[^a-z0-9_]+", "_", os.path.splitext(os.path.basename(rel))[0].lower()).strip("_") or "db"
    if alias[0].isdigit():
        alias = "db_" + alias
    alias = alias[:30]
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,29}", alias) or alias in ("main", "temp") or alias in CORE:
        fail("--as takes a short name: lower-case letters, digits and _", 2)
    con = connect(True, attach=False)
    taken = dict(attachments(con))
    if alias in taken and taken[alias] != rel:
        fail("there is already an attached database called %s; give another name with --as" % alias, 3)
    other = sqlite3.connect(uri(full, "ro"), uri=True, timeout=10)
    other.execute("PRAGMA trusted_schema = OFF")
    other.execute("PRAGMA cell_size_check = ON")
    deadline(other, 900)
    try:
        res = [r[0] for r in other.execute("PRAGMA integrity_check(20)")]
        tabs = other.execute("SELECT count(*) FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%'").fetchone()[0]
    except sqlite3.Error as e:
        fail("%s could not be read as a database (%s); it is kept as a file, not attached" % (rel, "it took too long" if "interrupted" in str(e) else "it is damaged"), 3)
    finally:
        other.close()
    if res != ["ok"]:
        fail("%s failed its integrity check (%s); it is kept as a file, not attached" % (rel, re.sub(r"\s+", " ", res[0] if res else "no answer")[:120]), 3)
    if not tabs:
        fail("%s has no tables" % rel, 3)
    con.execute("INSERT INTO attached (alias, path, sha256, size, tables, checked_at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (alias) DO UPDATE SET sha256 = excluded.sha256, size = excluded.size, tables = excluded.tables, checked_at = excluded.checked_at",
                (alias, rel, sha_of(full), os.path.getsize(full), tabs, now()))
    con.commit()
    con.close()
    print(json.dumps({"alias": alias, "path": rel, "tables": tabs, "size": os.path.getsize(full)}))


