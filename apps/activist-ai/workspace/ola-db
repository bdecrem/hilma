def disk():
    """This project's disk: the volume's size and use, and what takes the room (no file names)."""
    st = os.statvfs(WORK)
    total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
    used = total - st.f_bfree * st.f_frsize
    sizes = {"files": 0, "data": 0, "ola": 0}
    count = 0
    for root, dirs, files in os.walk(WORK):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d)) and d != "lost+found"]
        top = os.path.relpath(root, WORK).split(os.sep)[0]
        for f in files:
            count += 1
            if count > 500000:
                break
            try:
                size = os.lstat(os.path.join(root, f)).st_size
            except OSError:
                continue
            if top == ".ola":
                sizes["ola"] += size
            elif top == "." and re.fullmatch(r"project\.db(-wal|-shm|-journal)?", f):
                sizes["data"] += size
            else:
                sizes["files"] += size
    return {"total": total, "used": used, "free": free, **sizes}


