STOP = set("a an and are as at by de del der des die du el en et for from in into is la las le les los of on or the to und with van von".split())
DOI = re.compile(r"\b(10\.\d{4,9}/[^\s\"<>]+)", re.I)


def norm_doi(d):
    d = (d or "").strip().lower()
    d = re.sub(r"^(https?://(dx\.)?doi\.org/|doi:\s*)", "", d)
    return d.rstrip(".,;)]")


def parse_cite(cite):
    """Title, DOI and authors' surnames from a citation in the usual shapes (APA, Chicago, plain)."""
    out = {"doi": None, "title": None, "authors": None}
    m = DOI.search(cite or "")
    if m:
        out["doi"] = norm_doi(m.group(1))
    m = re.search(r"\((\d{4}[a-z]?|n\.d\.)\)\.?\s*(.+?)(?:\.\s|\?\s|$)", cite or "")
    if m:
        out["title"] = m.group(2).strip()
        names = re.findall(r"([A-Z][\w'\u00c0-\u024f-]+),\s+(?:[A-Z]\.|[A-Z][a-z]+)", cite[: m.start()])
        out["authors"] = "; ".join(names) or None
    else:
        m = re.search(r"[\"\u201c](.+?)[\"\u201d]", cite or "")
        if m:
            out["title"] = m.group(1)
    return out


def words(s):
    return [w for w in re.findall(r"\w+", match_key(s or "")) if len(w) > 2 and w not in STOP]


def check_doc(con, doc_id, expect):
    """Compares a document's first pages with what was expected; stores and returns the result.

    result: 'match' (what was checked is there), 'mismatch' (something expected is missing or
    contradicted: a wrong document), 'unsure' (nothing could be checked, e.g. no text)."""
    if expect.get("cite"):
        c = parse_cite(expect["cite"])
        for k in ("title", "doi", "authors"):
            expect[k] = expect.get(k) or c[k]
    rows = con.execute("SELECT page, text FROM doc_text WHERE doc_id = ? AND page <= 3 ORDER BY page", (doc_id,)).fetchall()
    doc = con.execute("SELECT title, pages FROM documents WHERE id = ?", (doc_id,)).fetchone()
    first = match_key(" ".join(r[1] for r in rows if r[0] <= 2) + " " + (doc[0] or ""))
    first3 = re.sub(r"\s+", "", " ".join(r[1] for r in rows).lower())
    found_words = set(re.findall(r"\w+", first))
    notes, good, bad = [], 0, 0
    if not first.strip():
        notes.append("no text could be read from the first pages")
    if expect.get("title") and first.strip():
        want = words(expect["title"])
        if want:
            share = sum(1 for w_ in want if w_ in found_words) / len(want)
            whole = match_key(expect["title"]).strip(" .") in first
            if whole or share >= 0.8:
                good += 1
                notes.append("the title is on the first pages")
            elif share < 0.5:
                bad += 1
                notes.append("the title is not on the first pages (%d of %d of its words)" % (round(share * len(want)), len(want)))
            else:
                notes.append("only part of the title is on the first pages (%d of %d words)" % (round(share * len(want)), len(want)))
    if expect.get("doi"):
        want = re.sub(r"\s+", "", norm_doi(expect["doi"]))
        if want and want in first3:
            good += 1
            notes.append("the DOI is on the first pages")
        else:
            others = sorted({norm_doi(x) for x in DOI.findall(" ".join(r[1] for r in rows))} - {want})
            if others:
                bad += 1
                notes.append("the first pages name another DOI: " + others[0][:80])
            else:
                notes.append("no DOI on the first pages")
    if expect.get("authors") and first.strip():
        names = [n.strip() for n in re.split(r"[;\n]| and ", expect["authors"]) if n.strip()]
        surnames = [words(n.split(",")[0])[-1:] for n in names]
        surnames = [s[0] for s in surnames if s]
        if surnames:
            hit = sum(1 for s in surnames if s in found_words)
            if hit == len(surnames):
                good += 1
                notes.append("the authors are named")
            elif hit == 0:
                bad += 1
                notes.append("none of the authors is named on the first pages")
            else:
                notes.append("%d of %d authors named" % (hit, len(surnames)))
    if expect.get("pages") and doc[1] and doc[1] < int(expect["pages"]) and doc[1] <= 2:
        bad += 1
        notes.append("it has %d page%s, so it may be a preview" % (doc[1], "" if doc[1] == 1 else "s"))
    result = "mismatch" if bad else "match" if good else "unsure"
    con.execute("UPDATE documents SET check_result = ?, check_detail = ?, expect = ? WHERE id = ?", (result, "; ".join(notes), json.dumps({k: v for k, v in expect.items() if v}), doc_id))
    con.commit()
    return {"result": result, "detail": "; ".join(notes)}


