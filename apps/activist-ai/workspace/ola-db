def snapshot_api(sub, opt):
    """A snapshot's database copy, checked here and not on the host (review 4, open: the host opened
    a file the agent controls). snapshot-check makes the copy by SQLite's online backup into
    .ola/tmp, checks it (integrity_check with cell_size_check, nothing in its schema trusted), counts
    its real tables, and prints {name, sha256, size, integrity, tables}. snapshot-send --name N
    streams those bytes and removes the copy. The host keeps the bytes only if their sha256 is the
    one this check reported, so it never opens the database itself."""
    import hashlib
    pat = r"snap-[0-9]+-[0-9a-f]{16}\.db"
    if sub == "snapshot-send":
        name = opt.get("name", "")
        if not re.fullmatch(pat, name):
            fail("snapshot-send: --name", 2)
        p = os.path.join(TMP, name)
        try:
            fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            fail("snapshot-send: no such copy", 4)
        try:
            with os.fdopen(fd, "rb") as f:
                shutil.copyfileobj(f, sys.stdout.buffer, 1 << 20)
        finally:
            try:
                os.unlink(p)
            except OSError:
                pass
        return
    os.makedirs(TMP, exist_ok=True)
    for n in os.listdir(TMP):  # an earlier snapshot's copy that was never sent
        if re.fullmatch(pat, n):
            try:
                os.unlink(os.path.join(TMP, n))
            except OSError:
                pass
    name = "snap-%d-%s.db" % (os.getpid(), os.urandom(8).hex())
    p = os.path.join(TMP, name)
    src = connect(False)
    dst = sqlite3.connect(p)
    src.backup(dst)
    dst.execute("PRAGMA journal_mode = DELETE")  # one file, as the host keeps it
    dst.close()
    src.close()
    integrity, tables = None, {}
    try:
        c = sqlite3.connect(p)
        c.execute("PRAGMA query_only = ON")
        c.execute("PRAGMA trusted_schema = OFF")
        c.execute("PRAGMA cell_size_check = ON")
        integrity = c.execute("PRAGMA integrity_check").fetchone()[0]
        q = "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND name NOT LIKE 'doc_text_%' AND coalesce(sql, '') NOT LIKE 'CREATE VIRTUAL%' ORDER BY name"
        for (t,) in c.execute(q).fetchall():
            tables[t] = c.execute('SELECT count(*) FROM "%s"' % t.replace('"', '""')).fetchone()[0]
        c.close()
    except sqlite3.Error:
        integrity = None
    h = hashlib.sha256()
    size = 0
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
            size += len(chunk)
    print(json.dumps({"name": name, "sha256": h.hexdigest(), "size": size, "integrity": integrity, "tables": tables}))


def api(argv):
    sub = argv[0] if argv else ""
    opt = {}
    i = 1
    while i < len(argv):
        if argv[i].startswith("--") and i + 1 < len(argv):
            opt[argv[i][2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    if sub == "disk":
        print(json.dumps(disk()))
        return
    if sub in ("snapshot-check", "snapshot-send"):
        return snapshot_api(sub, opt)
    con = connect(False)
    deadline(con, 8)
    try:
        if sub == "tables":
            d = con.execute("SELECT count(*) AS n, coalesce(sum(pages), 0) AS pages, coalesce(sum(ocr_pages), 0) AS ocr, coalesce(sum(check_result = 'mismatch'), 0) AS wrong FROM documents").fetchone()
            by = {r[0]: r[1] for r in con.execute("SELECT added_by, count(*) FROM documents GROUP BY added_by")}
            print(json.dumps({"tables": tables_info(con), "documents": {"count": d["n"], "pages": d["pages"], "ocrPages": d["ocr"], "mismatches": d["wrong"], "web": by.get("web", 0), "upload": by.get("upload", 0), "agent": by.get("agent", 0)}, "size": db_size()}))
        elif sub == "browse":
            t = opt.get("table", "")
            allowed = {n for n, _ in user_tables(con)} | {"documents"} | {n for n, _ in attached_tables(con)}
            if t not in allowed:
                fail("no such table", 4)
            cols = [c for c, _ in columns(con, t)]
            offset = max(0, int(opt.get("offset", 0)))
            limit = min(200, max(1, int(opt.get("limit", 50))))
            where, params = "", []
            if opt.get("q"):
                like = "%" + opt["q"].replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"
                where = " WHERE " + " OR ".join("CAST(%s AS TEXT) LIKE ? ESCAPE '\\'" % qi(c) for c in cols)
                params = [like] * len(cols)
            order = ""
            if opt.get("sort") in cols:
                order = " ORDER BY %s %s" % (qi(opt["sort"]), "DESC" if opt.get("dir") == "desc" else "ASC")
            total = con.execute("SELECT count(*) FROM %s%s" % (qt(con, t), where), params).fetchone()[0]
            rows = con.execute("SELECT * FROM %s%s%s LIMIT ? OFFSET ?" % (qt(con, t), where, order), params + [limit, offset]).fetchall()
            print(json.dumps({"table": t, "columns": [{"name": a, "type": b} for a, b in columns(con, t)], "rows": [[cell(v) for v in r] for r in rows], "total": total, "offset": offset, "limit": limit}, default=str))
        elif sub == "docs":
            offset = max(0, int(opt.get("offset", 0)))
            limit = min(100, max(1, int(opt.get("limit", 50))))
            if opt.get("q"):
                hits, total, loose = search(opt["q"], limit, offset, mark=("\u0002", "\u0003"))
                print(json.dumps({"q": True, "hits": hits, "total": total, "anyWord": loose, "offset": offset}))
            else:
                total = con.execute("SELECT count(*) FROM documents").fetchone()[0]
                rows = con.execute("SELECT id, title, path, source_url, fetched_at, mime, pages, unit, chars, added_by, added_at, ocr_pages, check_result, check_detail FROM documents ORDER BY added_at DESC, id DESC LIMIT ? OFFSET ?", (limit, offset)).fetchall()
                print(json.dumps({"q": False, "documents": [dict(r) for r in rows], "total": total, "offset": offset}))
        elif sub in ("backup", "xlsx"):
            os.makedirs(TMP, exist_ok=True)
            tmp = os.path.join(TMP, "out-%d-%d" % (os.getpid(), int(time.time())))
            try:
                if sub == "backup":
                    # SQLite's online backup: a consistent copy while the agent may be writing.
                    dst = sqlite3.connect(tmp)
                    con.backup(dst)
                    dst.close()
                else:
                    t = opt.get("table", "")
                    if t not in {n for n, _ in user_tables(con)} | {"documents"} | {n for n, _ in attached_tables(con)}:
                        fail("no such table", 4)
                    try:
                        import openpyxl
                    except ImportError:
                        fail("Excel files need openpyxl, which is not installed here", 5)
                    con.set_progress_handler(None, 0)
                    wb = openpyxl.Workbook(write_only=True)
                    ws = wb.create_sheet(t.replace(".", " ")[:31])
                    cols = [c for c, _ in columns(con, t)]
                    ws.append(cols)
                    from openpyxl.cell import WriteOnlyCell

                    def xcell(v):
                        v = cell(v, 32000)
                        if isinstance(v, str) and v[:1] == "=":
                            c = WriteOnlyCell(ws, value=v)
                            c.data_type = "s"  # text, never a formula
                            return c
                        return v

                    for n, r in enumerate(con.execute("SELECT * FROM " + qt(con, t))):
                        if n >= 1048575:
                            break
                        ws.append([xcell(v) for v in r])
                    wb.save(tmp)
                with open(tmp, "rb") as f:
                    shutil.copyfileobj(f, sys.stdout.buffer, 1 << 20)
            finally:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
        else:
            fail("api: tables, browse, docs, backup, xlsx or disk")
    except sqlite3.OperationalError as e:
        fail("interrupted" if "interrupted" in str(e) else "SQL: " + str(e), 3)


# ------------------------------------------------------------------ the command line

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], argv[1:]
    flags, args = {}, []
    i = 0
    bools = {"--write", "--json", "--replace", "--append"}
    while i < len(rest):
        a = rest[i]
        if a in bools:
            flags[a[2:]] = True
        elif a.startswith("--") and i + 1 < len(rest):
            flags[a[2:]] = rest[i + 1]
            i += 1
        else:
            args.append(a)
        i += 1
    if cmd == "init":
        init()
    elif cmd == "api":
        api(rest)
    elif cmd == "query":
        if len(args) != 1:
            fail('usage: ola-db query "<sql>" [--write] [--json] [--limit N]')
        query(args[0], flags.get("write"), flags.get("json"), int(flags.get("limit", 200)))
    elif cmd == "load":
        if len(args) != 1 or "table" not in flags:
            fail("usage: ola-db load <file> --table <name> [--note \"what it holds\"] [--replace | --append] [--sheet <name>]")
        load(args[0], flags["table"], flags.get("note"), "replace" if flags.get("replace") else "append" if flags.get("append") else None, flags.get("sheet"))
    elif cmd == "search":
        if not args:
            fail('usage: ola-db search "<words>" [--limit N]')
        hits, total, loose = search(" ".join(args), int(flags.get("limit", 10)))
        if flags.get("json"):
            print(json.dumps({"hits": hits, "total": total, "anyWord": loose}))
            return
        if not hits:
            print("No document in the project database mentions that.")
            return
        print("%d passage%s match%s%s; the best %d:" % (total, "" if total == 1 else "s", "es" if total == 1 else "", " (any of the words; none had all of them)" if loose else "", len(hits)))
        for h in hits:
            where = "%s %d" % (h["unit"], h["page"])
            src = h["source_url"] or "uploaded"
            scan = "; read from a scan, so words may be wrong" if h.get("method", "text").startswith("ocr") else ""
            print("\n- %s, %s (file %s; %s%s%s)\n  %s" % (h["title"], where, h["path"], src, ", fetched " + h["fetched_at"][:10] if h["fetched_at"] else "", scan, re.sub(r"\s+", " ", h["snip"])))
        print("\nRead the whole page with: ola-db query \"SELECT text FROM doc_text WHERE doc_id = <id> AND page = <n>\"  (ids: ola-db query \"SELECT id, title FROM documents\")")
        print("Cite a page as [file, p. N](doc:file#page=N), for example [%s, p. %d](doc:%s#page=%d)." % (hits[0]["path"], hits[0]["page"], hits[0]["path"], hits[0]["page"]))
    elif cmd == "add":
        if len(args) != 1:
            fail("usage: ola-db add <path> [--source <address>] [--fetched <date>] [--title <title>] [--by upload|web|agent] [--charset C] [--lang L] [--ocr auto|off|force] [--ocr-lang L] [--expect-title T] [--expect-doi D] [--expect-authors A] [--expect-cite C]")
        by = flags.get("by", "agent")
        if by not in ("upload", "web", "agent"):
            fail("--by is upload, web or agent")
        ocr = flags.get("ocr", "auto")
        if ocr not in ("auto", "off", "force"):
            fail("--ocr is auto, off or force")
        expect = {"title": flags.get("expect-title"), "doi": flags.get("expect-doi"), "authors": flags.get("expect-authors"), "cite": flags.get("expect-cite"), "pages": flags.get("expect-pages")}
        out, _ = add(args[0], flags.get("source"), flags.get("fetched"), flags.get("title"), by, charset=flags.get("charset"), lang=flags.get("lang"), ocr=ocr, ocr_lang=flags.get("ocr-lang"), expect=expect)
        if out.get("check", {}).get("result") == "mismatch":
            sys.stderr.write("ola-db: %s may not be the document you wanted: %s\n" % (out["path"], out["check"]["detail"]))
    elif cmd == "add-folder":
        if len(args) != 1:
            fail("usage: ola-db add-folder <folder> [--by upload|web|agent] [--ocr auto|off]")
        add_folder(args[0], flags.get("by", "agent") if flags.get("by", "agent") in ("upload", "web", "agent") else "agent", flags.get("ocr", "auto"))
    elif cmd == "check":
        if len(args) != 1 or not any(flags.get(k) for k in ("title", "doi", "authors", "cite")):
            fail('usage: ola-db check <path> [--title "..."] [--doi 10.x/y] [--authors "A; B"] [--cite "a citation"] [--pages N]')
        check(args[0], {"title": flags.get("title"), "doi": flags.get("doi"), "authors": flags.get("authors"), "cite": flags.get("cite"), "pages": flags.get("pages")})
    elif cmd == "attach":
        if len(args) != 1:
            fail("usage: ola-db attach <file.db> [--as <name>]")
        attach(args[0], flags.get("as"))
    elif cmd == "remove":
        if len(args) != 1:
            fail("usage: ola-db remove <path>")
        remove(args[0])
    elif cmd == "tables":
        con = connect(False)
        t = tables_info(con)
        d = con.execute("SELECT count(*), coalesce(sum(pages), 0), coalesce(sum(ocr_pages), 0) FROM documents").fetchone()
        print("Documents: %d (%d pages or parts%s), searchable with: ola-db search \"words\"" % (d[0], d[1], ", %d read from scans" % d[2] if d[2] else ""))
        if not t:
            print("No tables yet. Load one with: ola-db load <file> --table <name> --note \"what it holds\"")
        for x in t:
            print("- %s: %s rows, from %s%s%s" % (x["name"], x["rows"], x["source"] or "?", " (a database the person brought; read-only)" if x.get("attached") else "", "; " + x["description"] if x["description"] else ""))
    elif cmd == "describe":
        con = connect(False)
        if len(args) != 1 or args[0] not in {n for n, _ in user_tables(con)} | CORE | {n for n, _ in attached_tables(con)}:
            fail("usage: ola-db describe <table>")
        for c, k in columns(con, args[0]):
            print("  %s %s" % (c, k))
        query("SELECT * FROM %s LIMIT 3" % qt(con, args[0]), False, False, 3)
    else:
        fail("unknown command %s; see ola-db --help" % cmd)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except BrokenPipeError:
        pass
    except (ValueError, zipfile.BadZipFile, UnicodeError, OSError, subprocess.TimeoutExpired) as e:
        fail(type(e).__name__ + ": " + str(e)[:300], 3)
