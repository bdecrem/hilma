// opencode's config inside every workspace VM (read-only in the image).
// These settings are defaults for the agent's behavior, NOT containment: the agent's shell
// can ignore all of them. Containment is the VM having no network but the door socket.
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ola": {
      "name": "Ola",
      "env": ["BOX_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:4180/v1" },
      "models": {
        "general": {
          "modelID": "general",
          "name": "general",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16000 }
        },
        // Fallback to a hosted open model: the gateway serves `hosted` only to a project whose owner
        // turned it on, or for the one run they handed over; the front desk switches a session to it
        // for that run and back after. Its limits are the provider model's (gateway HOSTED_MODEL).
        "hosted": {
          "modelID": "hosted",
          "name": "hosted",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32000 }
        }
      }
    }
  },
  "model": "ola/general",
  "update": "disable",
  // Where the agent is and how people see what it makes (AGENTS.md, beside this file).
  "instructions": ["/opt/ola/config/opencode/AGENTS.md"],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    // Ola's own web tools ask the person first (the front desk sets the same rules per session,
    // from the project's choice); the gateway refuses what the project did not approve.
    { "action": "shell", "resource": "ola-search *", "effect": "ask" },
    { "action": "shell", "resource": "ola-fetch *", "effect": "ask" },
    { "action": "shell", "resource": "/opt/ola/bin/ola-search *", "effect": "ask" },
    { "action": "shell", "resource": "/opt/ola/bin/ola-fetch *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // the desktop app's browser and preview tool: there is no desktop app here
    { "action": "browser", "resource": "*", "effect": "deny" }
  ]
}
