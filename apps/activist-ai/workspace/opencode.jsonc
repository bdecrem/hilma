// opencode's config inside every workspace VM (read-only in the image).
// These settings are defaults for the agent's behavior, NOT containment: the agent's shell
// can ignore all of them. Containment is the VM having no network but the door socket.
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ola": {
      "name": "Ola",
      "env": ["BOX_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:4180/v1" },
      "models": {
        "general": {
          "modelID": "general",
          "name": "general",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 131072, "output": 16000 }
        }
      }
    }
  },
  "model": "ola/general",
  "update": "disable",
  // Where the agent is and how people see what it makes (AGENTS.md, beside this file).
  "instructions": ["/opt/ola/config/opencode/AGENTS.md"],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // the desktop app's browser and preview tool: there is no desktop app here
    { "action": "browser", "resource": "*", "effect": "deny" }
  ]
}
