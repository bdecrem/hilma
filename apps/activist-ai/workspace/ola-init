#!/bin/sh
# PID 1's child inside a workspace VM (run with --init, so tini reaps and forwards signals).
#
# The VM has no network interface but loopback. There are two paths, one out and one in:
#   out: 127.0.0.1:4180 inside the VM -> /ola/gw/gateway.sock, a host socket mounted in.
#        On the host, that socket's listener (workspace/door.mjs) connects only to the
#        model gateway. Nothing else on the host is reachable from here.
#   in:  the host's desk (workspace/desk.mjs) runs `socat STDIO TCP:127.0.0.1:4096` through
#        `container exec` for each connection, to opencode serve on 127.0.0.1:4096. The image's
#        root is read-only, and nothing is published with --publish-socket (which would need a
#        writable root).
# None of this is the security boundary. The boundary is that the VM has no route
# anywhere: rewriting this file from inside changes nothing a hostile process could not
# already do, which is talk to the door socket.
set -eu
mkdir -p "$HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
# The project database, /work/project.db: made at the first start, brought up to date at every
# start (a project made before it existed gets it here). Not fatal: opencode starts regardless.
/opt/ola/bin/ola-db init || echo "ola-init: the project database could not be prepared" >&2
# A turn the front desk began and never ended (the VM stopped mid-turn): ended as interrupted, so
# what it changed is recorded with its engine (OLA-224, ola-db made-by).
/opt/ola/bin/ola-db made-by end --stale >/dev/null 2>&1 || true
# Pieces of an upload left for two days, and views not used for a week, are cleared.
find /work/.ola/uploads -maxdepth 1 -name "*.part" -mtime +2 -delete 2>/dev/null || true
find /work/.ola/cache/views -maxdepth 1 -type f -mtime +7 -delete 2>/dev/null || true
# Half-unpacked zips of an ola-unzip that was killed: nothing runs yet, so none is in use.
rm -rf /work/.ola/tmp/unzip-* 2>/dev/null || true
socat TCP-LISTEN:4180,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/ola/gw/gateway.sock &
exec opencode serve --hostname 127.0.0.1 --port 4096
