#!/usr/bin/python3 -I
# ola-publish: put a page Ola made on the public web, from the conversation (OLA-230).
#
#   ola-publish <folder | page.html> --files index.html,style.css,...
#       Run as a command of its own. Ola's computer has no network, so this command cannot publish
#       by itself: running it asks the person first (always, even under "Lots of permissions"),
#       showing exactly these files and the address. On their yes Ola's server checks the files
#       again (secrets, private data, kinds of files), publishes them at sites.ola.cx/<project>/
#       and hands the outcome back here; this command waits for it and prints it. A "no" means the
#       command never runs. --files is the list `publish.py check` printed (paths inside the folder).
#   ola-publish unpublish
#       Takes the project's published pages down, after the person's yes (also always asked).
#   ola-publish status
#       The last publish's outcome (never asked): use it when the publish above was still going.
#       An outcome already shown, or older than 15 minutes, is printed as a record of the past, never
#       as the address's state now (OLA-421): this computer cannot look at the address, and on Nov 23
#       Ola gave a link "currently live and shows Bart" from such a record while the address was 404
#       (the page had been taken down with the button) and the page asked about said Garden Club.
#
# The front desk writes the outcome with `ola-publish --result` (the JSON on stdin), into
# /work/.ola/publish/result.json. Exit 0 published (and the address shows it), 1 not published,
# 2 used wrongly, 3 still going, 4 sent but the address does not show it yet, 5 (status) only a record
# of an earlier publish, not a look at the address now.
import json, os, sys, tempfile, time

DIR = os.environ.get("OLA_PUBLISH_DIR", "/work/.ola/publish")
RESULT = os.path.join(DIR, "result.json")
WAIT = float(os.environ.get("OLA_PUBLISH_WAIT", "110"))
FRESH = 15 * 60


def say(*lines):
    for l in lines:
        print(l)
    sys.stdout.flush()


def usage(why):
    say("ola-publish: " + why, "Use: ola-publish site --files index.html,style.css (the list publish.py check printed), as a command of its own.")
    sys.exit(2)


def read():
    try:
        with open(RESULT, encoding="utf-8") as f:
            r = json.load(f)
        return r if isinstance(r, dict) else None
    except (OSError, ValueError):
        return None


def write(r):
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=DIR, prefix=".result.")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(r, f)
    os.replace(tmp, RESULT)


def tell(r):
    """Prints an outcome for the agent; returns the exit code."""
    st = r.get("state")
    if st == "done" and r.get("unpublished") and r.get("unconfirmed"):
        say(f"Taken down from Ola's address. Ola could not read {r.get('url')} just now to confirm it (the host answered with its bot check).",
            "Tell the person the page was taken down and to open the address to see that it is gone.")
        return 0
    if st == "done" and r.get("unpublished"):
        say(f"Taken down: {r.get('url')} now shows nothing." if r.get("live") else (r.get("message") or f"Taken down; {r.get('url')} stops showing it within a few minutes."),
            "Tell the person the page is no longer on the web.")
        return 0
    if st == "done":
        # What Ola says comes from the address itself, fetched by Ola's server after publishing and
        # compared with the page just published (OLA-267), never from what Ola believes it did.
        shows = (r.get("shows") or "").strip()
        head = ("Published again" if r.get("again") else "Published") + f": {r.get('url')} ({r.get('count')} file(s))."
        if r.get("live"):
            say(head,
                "Checked: the address answers with exactly the page just published" + (f"; it shows: “{shows}”." if shows else "."),
                "Tell the person it is live" + (f" and what it shows (“{shows}”)" if shows else "")
                + f", with the address exactly as it is here, on its own (no bold, quotes or other marks around it): {r.get('url')}",
                "If that is not the page the person asked for, say so plainly instead, make the right page, then publish it.")
            return 0
        if r.get("unconfirmed"):
            # The host's bot check answered Ola's server instead of the page (OLA-230): nothing is
            # known about the page, so neither "live" nor "not live" is said.
            say(head,
                "Not checked: Ola's server could not read the address just now (the host answered with its bot check instead of the page).",
                f"Tell the person it was published at {r.get('url')} (the address on its own, no marks around it), that Ola could not double-check it just now, and to open it to see. Do not publish again and do not run anything else for it.")
            return 0
        say(head,
            "NOT LIVE YET: the address does not show the page just published" + (f"; it still shows: “{shows}”." if shows else "."),
            "Do not tell the person it is live. Tell them in one plain sentence that it was sent but the address still shows the earlier page, and that it usually appears within a few minutes; offer to publish it again if it does not.")
        return 4
    if st == "publishing":
        say("It is still being published. Run `ola-publish status` in a minute to see whether it is live; do not run ola-publish again for the same files.")
        return 3
    say("Not published: " + str(r.get("message") or "Ola's server did not publish it."), "Tell the person this in plain words. Nothing went public.")
    return 1


def past(r):
    """An outcome already shown (or old): a record, never a claim about the address now (OLA-421)."""
    when = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(float(r.get("written") or 0))) if r.get("written") else "an earlier time"
    if r.get("state") == "done" and r.get("unpublished"):
        what = f"the pages at {r.get('url')} were taken down"
    elif r.get("state") == "done":
        shows = (r.get("shows") or "").strip()
        what = f"{r.get('url')} was published" + (f", showing “{shows}”" if shows else "")
    else:
        what = "a publish was not done (" + str(r.get("message") or "Ola's server did not publish it") + ")"
    say(f"Record only: the last publish from this project's conversation, at {when}, said {what}.",
        "This is not a look at the address now. This computer cannot look, and since then the page may have been taken down"
        " (with the Unpublish button, or by an admin) or published again, and the page in the project may say something else.",
        "Never tell the person a page is live, or give them an address as working, from this record.",
        "To give them a link to a page, publish the page they mean now (the publish skill: prepare, check, then"
        " `ola-publish <folder> --files <list>`): its result says what the address shows.")
    return 5


HELP = """ola-publish puts a page from this project on the public web, at https://sites.ola.cx/<project>/.
Follow the publish skill first (the skill tool, id "publish"; its text is /opt/ola/skills/publish/SKILL.md):
`publish.py where`, then `prepare` and `check`, then this command with the list `check` printed.
  ola-publish site --files index.html,style.css   publish the folder site/ (made by the publish skill's
                                                  prepare, from the page the person asked for); --files is
                                                  the list `publish.py check site` printed. Run it as a
                                                  command of its own: the person is asked, with the list.
  ola-publish unpublish                           take the project's pages down (also asked)
  ola-publish status                              the last publish's outcome (never asked); once shown,
                                                  only a record, never what the address shows now
Publishing again: run prepare again first. site/ is a copy and does not change when the page does."""


def main(argv):
    if argv in ([], ["--help"], ["-h"], ["help"]):
        say(HELP)
        return 0
    if argv[:1] == ["--result"]:
        try:
            r = json.loads(sys.stdin.read(64 * 1024))
        except ValueError:
            usage("--result takes the outcome as JSON on stdin")
        if not isinstance(r, dict) or r.get("state") not in ("publishing", "done", "failed"):
            usage("not an outcome")
        r["written"] = time.time()
        write(r)
        print(json.dumps({"ok": True}))
        return 0
    if argv == ["status"]:
        r = read()
        if not r:
            say("Nothing has been published from this project's conversation yet.",
                "To give the person a link to a page, publish that page (the publish skill: prepare, check, then ola-publish).")
            return 1
        if r.get("state") != "publishing" and (r.get("used") or time.time() - float(r.get("written") or 0) > FRESH):
            return past(r)
        code = tell(r)
        if code != 3 and r.get("state") != "publishing":
            r["used"] = True
            write(r)
        return code
    if argv == ["unpublish"]:
        argv, target_fixed = [], "(unpublish)"
    else:
        target_fixed = None
    target, files, i = target_fixed, ([] if target_fixed else None), 0
    while i < len(argv):
        a = argv[i]
        if a == "--files":
            if files is not None or i + 1 >= len(argv):
                usage("name the files once, after --files, separated by commas")
            files = [f.strip() for f in argv[i + 1].split(",") if f.strip()]
            i += 2
            continue
        if a.startswith("-") or target is not None:
            usage(f"“{a}” is not a folder, a page or --files")
        target = a
        i += 1
    if not target:
        usage("name the folder to publish")
    if not files and not target_fixed:
        usage("list every file that will be public after --files")
    if not target_fixed:
        target = target.removeprefix("/work/").removeprefix("./").rstrip("/")
    # The person's yes came before this ran: the front desk wrote "publishing" for exactly this
    # folder and list, then let the command go. Without that, nobody said yes to it.
    end = time.time() + WAIT
    while True:
        r = read()
        mine = r and not r.get("used") and r.get("target") == target and sorted(r.get("files") or []) == sorted(files) and time.time() - float(r.get("written") or 0) < FRESH + WAIT
        if not mine:
            say("Not published: Ola's server has no yes from the person for exactly this folder and these files.",
                "Run `ola-publish <folder> --files <the list>` as a command of its own (no pipes, ; or &&, nothing before it), so the person is asked.")
            return 1
        if r.get("state") != "publishing" or time.time() > end:
            break
        time.sleep(1)
    code = tell(r)
    if code != 3:
        # Shown once: the same outcome does not count as a yes for the next run.
        if r.get("state") != "publishing":
            r["used"] = True
            write(r)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
