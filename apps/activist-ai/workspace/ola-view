#!/usr/bin/python3 -I
"""ola-view: what "Open" shows of a file, made inside the sealed computer (never in the browser).

Run by the front desk through `container exec`. The file is someone else's (a model's, a
stranger's), so it is read as hostile and nothing in it is run: a PDF meets poppler here and
reaches the browser only as page pictures; a Word, Markdown or text file comes out as our own
plain HTML with every character of the file escaped, no address of the file's kept as a link,
no remote template or picture fetched (there is no network here anyway); a spreadsheet's cells
come out as values, its formulas as text, never evaluated, its external links never followed.

  ola-view pdf-info <path>            JSON: pages, each page's size, and (if the project database
                                      holds it) each page's text and whether it came from a scan
  ola-view pdf-page <path> <n> [--width 1000]
                                      one header line {"size": N}, then a PNG of page n
  ola-view doc <path>                 one header line {"size": N}, then the HTML of a .docx, .md,
                                      .markdown, .txt or .odt
  ola-view table <path> [--sheet S] [--offset N --limit N --sort C --dir asc|desc --q words]
                                      JSON: a page of a CSV, TSV or Excel file's rows, like the
                                      Data tab's tables, and the file's sheets
Paths are relative to /work, plain names, no symlink followed. Results are cached in
/work/.ola/cache/views by the file's sha256.
"""
import csv, hashlib, html, json, os, re, sqlite3, stat, subprocess, sys, time, zipfile
import xml.etree.ElementTree as ET

# In the image: /opt/ola/lib. On a developer machine (web/dev.mjs runs these tools on a folder): ./lib.
sys.path.insert(0, os.environ.get("OLA_LIB") or ("/opt/ola/lib" if os.path.isdir("/opt/ola/lib") else os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib")))
from olatext import clean, decode_bytes  # noqa: E402

WORK = os.environ.get("OLA_WORK", "/work")
CACHE = os.path.join(WORK, ".ola", "cache", "views")
NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._()+,-]{0,199}")
MAX_IN = 64 << 20
MAX_ROWS = 1_000_000
MAX_COLS = 300


def fail(code, msg):
    sys.stderr.write("ola-view: " + msg + "\n")
    sys.exit(code)


def open_plain(rel):
    """An fd for /work/<rel>: every part a plain name, opened with O_NOFOLLOW (ola-get's walk)."""
    parts = rel.split("/")
    if not 1 <= len(parts) <= 6 or not all(NAME.fullmatch(p) and ".." not in p for p in parts):
        fail(2, "not a plain path")
    fd = os.open(WORK, os.O_RDONLY | os.O_DIRECTORY)
    for i, part in enumerate(parts):
        last = i == len(parts) - 1
        try:
            nfd = os.open(part, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | (0 if last else os.O_DIRECTORY), dir_fd=fd)
        except OSError:
            fail(4, "no such file")
        os.close(fd)
        fd = nfd
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        fail(4, "not a file")
    os.set_blocking(fd, True)
    return fd


def sha_fd(fd):
    h = hashlib.sha256()
    os.lseek(fd, 0, 0)
    while True:
        b = os.read(fd, 1 << 20)
        if not b:
            break
        h.update(b)
    os.lseek(fd, 0, 0)
    return h.hexdigest()


FDS = []


def snapshot(rel):
    """(a path to the file as opened, sha256): tools are given /proc/self/fd/<n> of the file this
    walk opened, never the agent's path, so a file swapped for a link after the check is not
    what they read (subprocesses get the fd through pass_fds)."""
    fd = open_plain(rel)
    os.set_inheritable(fd, True)
    FDS.append(fd)
    os.makedirs(CACHE, mode=0o700, exist_ok=True)
    # /proc/self/fd in the VM (a fresh open of the same file); /dev/fd where there is no /proc (a Mac running web/dev.mjs).
    return ("/proc/self/fd/%d" if os.path.isdir("/proc/self/fd") else "/dev/fd/%d") % fd, sha_fd(fd)


def tool(args, timeout):
    return subprocess.run(args, capture_output=True, timeout=timeout, pass_fds=tuple(FDS))


def emit(data):
    out = sys.stdout.buffer
    out.write((json.dumps({"size": len(data)}) + "\n").encode())
    out.write(data)
    out.flush()


# ------------------------------------------------------------------ PDFs

def pdf_info(rel):
    copy, sha = snapshot(rel)
    r = tool(["pdfinfo", "-f", "1", "-l", "3000", copy], 120)
    info = r.stdout.decode("utf-8", "replace")
    m = re.search(r"^Pages:\s*(\d+)", info, re.M)
    if r.returncode != 0 or not m:
        fail(3, "this PDF could not be read")
    pages = int(m.group(1))
    sizes = {}
    for pm in re.finditer(r"^Page\s+(\d+) size:\s*([\d.]+) x ([\d.]+)", info, re.M):
        sizes[int(pm.group(1))] = [float(pm.group(2)), float(pm.group(3))]
    default = re.search(r"^Page size:\s*([\d.]+) x ([\d.]+)", info, re.M)
    default = [float(default.group(1)), float(default.group(2))] if default else [612.0, 792.0]
    out = {"pages": pages, "sizes": [sizes.get(i, default) for i in range(1, min(pages, 3000) + 1)], "texts": None, "methods": None}
    db = os.path.join(WORK, "project.db")
    if os.path.isfile(db):
        try:
            con = sqlite3.connect("file:%s?mode=ro" % db, uri=True, timeout=5)
            row = con.execute("SELECT id FROM documents WHERE path = ? AND sha256 = ?", (rel, sha)).fetchone()
            if row:
                budget = 1_500_000
                texts = {}
                for page, text in con.execute("SELECT page, text FROM doc_text WHERE doc_id = ? ORDER BY page", (row[0],)):
                    t = (text or "")[:max(0, budget)]
                    budget -= len(t)
                    texts[int(page)] = t
                out["texts"] = [texts.get(i, "") for i in range(1, min(pages, 3000) + 1)]
                methods = {int(p): (m_, c) for p, m_, c in con.execute("SELECT page, method, confidence FROM doc_pages WHERE doc_id = ?", (row[0],))}
                out["methods"] = [methods.get(i, ("text", None))[0] for i in range(1, min(pages, 3000) + 1)]
            con.close()
        except sqlite3.Error:
            pass
    print(json.dumps(out))


def pdf_page(rel, n, width):
    copy, sha = snapshot(rel)
    width = max(200, min(2000, width))
    png = os.path.join(CACHE, "%s-p%d-w%d.png" % (sha, n, width))
    if not os.path.isfile(png):
        base = png[:-4] + ".%d" % os.getpid()
        r = tool(["pdftoppm", "-f", str(n), "-l", str(n), "-scale-to-x", str(width), "-scale-to-y", "-1", "-png", "-singlefile", copy, base], 120)
        if r.returncode != 0 or not os.path.isfile(base + ".png"):
            fail(4, "no such page")
        os.replace(base + ".png", png)
    with open(png, "rb") as f:
        emit(f.read())


