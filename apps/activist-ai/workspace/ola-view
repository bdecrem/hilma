body{margin:0 auto;max-width:44rem;padding:2.5rem 1.25rem 4rem;font:18px/1.6 Georgia,'Iowan Old Style','Times New Roman',serif;color:#1d1a16;background:#fbf8f1;overflow-wrap:anywhere}
h1,h2,h3,h4{font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif;line-height:1.25;color:#25407a;margin:1.6em 0 .5em}
h1{font-size:1.7rem}h2{font-size:1.3rem}h3{font-size:1.1rem}h4{font-size:1rem}
p{margin:0 0 .9em}ul,ol{padding-left:1.4em}li{margin:.2em 0}
