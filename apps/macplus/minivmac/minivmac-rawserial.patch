+#if EmRawSerial
+/*
+	Called periodically from the main loop. Pull socket bytes into the Rx ring,
+	and if the SCC is ready for a char (Rx enabled, none pending), hand one to
+	channel 0 and raise the receive interrupt - mirroring how LocalTalkTick
+	feeds channel 1.
+*/
+GLOBALPROC RawSerialTick(void)
+{
+	RawSer_Poll();
+	if (SCC.a[0].RxEnable && (! SCC.a[0].RxChrAvail)) {
+		int c = RawSer_RxPop();
+		if (c >= 0) {
+			SCC.a[0].RxBuff = (ui3r)c;
+			SCC.a[0].RxChrAvail = trueblnr;
+			SCC.a[0].FirstChar = trueblnr;
+			CheckSCCInterruptFlag();
+		}
+	}
+}
+#endif
