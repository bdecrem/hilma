+#if EmRawSerial
+/*
+	Raw async serial transport for channel 0 (the modem port), bridged to a
+	host TCP socket. A companion "virtual modem" listens at the host endpoint
+	(env MNVM_SERIAL, default 127.0.0.1:5454), speaks Hayes AT, and bridges to
+	the Mac mini's listener - so the real Macinclaude apps run their full modem
+	handshake (AT/OK, ATDT, CONNECT) unmodified, inside the emulator.
+*/
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+#include <stdlib.h>
+
+#define RawSer_RxBufSz 8192
+static int RawSer_fd = -1;
+static unsigned char RawSer_RxBuf[RawSer_RxBufSz];
+static int RawSer_RxHead = 0;
+static int RawSer_RxTail = 0;
+static blnr gRawSerARxInt = falseblnr;   /* channel-0 Rx interrupt pending */
+
+static void RawSer_Connect(void)
+{
+	const char *spec; char host[128]; int port; const char *colon;
+	struct sockaddr_in sa; int fd; int fl; int one = 1; size_t n;
+	if (RawSer_fd >= 0) {
+		return;
+	}
+	spec = getenv("MNVM_SERIAL");
+	if ((nullpr == spec) || (0 == *spec)) {
+		spec = "127.0.0.1:5454";
+	}
+	colon = strrchr(spec, ':');
+	if (nullpr == colon) {
+		return;
+	}
+	n = (size_t)(colon - spec);
+	if (n >= sizeof(host)) { n = sizeof(host) - 1; }
+	memcpy(host, spec, n); host[n] = 0;
+	port = atoi(colon + 1);
+	fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0) { return; }
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons((unsigned short)port);
+	if (inet_pton(AF_INET, host, &sa.sin_addr) != 1) { close(fd); return; }
+	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0) { close(fd); return; }
+	fl = fcntl(fd, F_GETFL, 0);
+	(void)fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+	(void)setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+	RawSer_fd = fd;
+}
+
+static void RawSer_Reset(void)
+{
+	/* UART reset only: flush the Rx ring and pending interrupt. Deliberately
+	 * keep the socket open - the emulator<->virtual-modem link is the "serial
+	 * cable" and persists for the whole run (the modem session, AT/ATDT/ATH,
+	 * lives on top of it), so a soft SCC reset mustn't hang up the cable. */
+	RawSer_RxHead = 0;
+	RawSer_RxTail = 0;
+	gRawSerARxInt = falseblnr;
+}
+
+static void RawSer_TxByte(ui3b b)
+{
+	unsigned char c = b;
+	ssize_t r;
+	RawSer_Connect();
+	if (RawSer_fd < 0) { return; }
+	r = send(RawSer_fd, &c, 1, 0);
+	if ((r < 0) && (errno != EAGAIN) && (errno != EWOULDBLOCK)) {
+		close(RawSer_fd); RawSer_fd = -1;
+	}
+}
+
+static void RawSer_Poll(void)
+{
+	unsigned char tmp[2048];
+	ssize_t r; ssize_t i;
+	RawSer_Connect();
+	if (RawSer_fd < 0) { return; }
+	r = recv(RawSer_fd, tmp, sizeof(tmp), 0);
+	if (r > 0) {
+		for (i = 0; i < r; i++) {
+			int nxt = (RawSer_RxTail + 1) % RawSer_RxBufSz;
+			if (nxt == RawSer_RxHead) { break; } /* full: drop rest */
+			RawSer_RxBuf[RawSer_RxTail] = tmp[i];
+			RawSer_RxTail = nxt;
+		}
+	} else if (r == 0) {
+		close(RawSer_fd); RawSer_fd = -1;
+	}
+}
+
+static int RawSer_RxPop(void) /* next byte 0..255, or -1 if none */
+{
+	int c;
+	if (RawSer_RxHead == RawSer_RxTail) { return -1; }
+	c = RawSer_RxBuf[RawSer_RxHead];
+	RawSer_RxHead = (RawSer_RxHead + 1) % RawSer_RxBufSz;
+	return c;
+}
+#endif /* EmRawSerial */
+
