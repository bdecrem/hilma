import Foundation

// Copy this file to Secrets.swift and customize. Secrets.swift is gitignored.
// The default points the iOS app at the production F2 backend at feynd.cc.

enum Secrets {
    enum Backend {
        case production    // https://feynd.cc
        case localhost(ip: String, port: Int)   // e.g. .localhost(ip: "192.168.7.189", port: 3000)
    }

    static let backend: Backend = .production

    static var backendBaseURL: URL {
        switch backend {
        case .production:
            return URL(string: "https://feynd.cc")!
        case .localhost(let ip, let port):
            return URL(string: "http://\(ip):\(port)")!
        }
    }
}
