{
  "code": "H1",
  "title": "Chord Shapes",
  "module": {
    "code": "shapes",
    "title": "Chord Shapes",
    "detail": "Left hand · sevenths, inversions, voice leading, the club voicings"
  },
  "lessons": [
    {
      "title": "Minor sevenths",
      "skill": "Root, flat third, fifth, flat seventh on the 1",
      "goal": "2 clean choruses at 70",
      "steps": [
        "m7"
      ],
      "theme": {
        "glyph": "keys:1357",
        "title": "Four notes",
        "line": "A minor triad plus the flat seventh. One more finger, and the chord sounds like a record."
      }
    },
    {
      "title": "Inversions",
      "skill": "Root, first, second inversion, one a bar",
      "goal": "2 clean choruses at 70",
      "steps": [
        "inv"
      ],
      "theme": {
        "glyph": "steps:3",
        "title": "Same notes, new bottom",
        "line": "Put the third on the bottom, then the fifth. The chord doesn't change; where your hand sits does."
      }
    },
    {
      "title": "Four chords",
      "skill": "Am F C G, root position, one a bar",
      "goal": "2 clean choruses at 70",
      "steps": [
        "loop"
      ],
      "theme": {
        "glyph": "bars:1",
        "title": "The minor loop",
        "line": "i VI III VII. Minor to its relative major and back round. Learn it, and you know a thousand songs."
      }
    },
    {
      "title": "Moving less",
      "skill": "Am F C G with the inversions that keep the hand still",
      "goal": "2 clean choruses at 70",
      "steps": [
        "lead"
      ],
      "theme": {
        "glyph": "hand",
        "title": "Voice leading",
        "line": "Keep the common tone, move the rest by a step. Four chords, the hand inside one fifth."
      }
    },
    {
      "title": "The backbeat",
      "skill": "The minor triad on 2 and 4, against the kick",
      "goal": "2 clean choruses at 80",
      "steps": [
        "chank"
      ],
      "theme": {
        "glyph": "bars:24",
        "title": "Off the 1",
        "line": "Leave the 1 to the drums. A chord on 2 and 4 is the chank of every blues and the skank of every reggae tune."
      }
    },
    {
      "title": "Suspend, resolve",
      "skill": "Sus4 on the 1, the minor on the 3",
      "goal": "2 clean choruses at 70",
      "steps": [
        "sus"
      ],
      "theme": {
        "glyph": "keys:145",
        "title": "Lean, then land",
        "line": "The fourth leans on the third. Two beats of tension, two of home."
      }
    },
    {
      "title": "The shell",
      "skill": "Root, flat third, flat seventh: the fifth left out",
      "goal": "2 clean choruses at 70",
      "steps": [
        "shell"
      ],
      "theme": {
        "glyph": "keys:137",
        "title": "Three that say it all",
        "line": "The third and the seventh are the guide tones. The fifth is furniture."
      }
    },
    {
      "title": "Minor nine",
      "skill": "Flat third, fifth, flat seventh, ninth; the bass has the root",
      "goal": "2 clean choruses at 70",
      "steps": [
        "m9"
      ],
      "theme": {
        "glyph": "keys:3572",
        "title": "The deep house chord",
        "line": "Leave the root to the bass. What's left is a major seventh shape that the bass turns into a minor nine."
      }
    }
  ],
  "later": [
    {
      "title": "Rootless A and B",
      "skill": "3 5 7 9 and 7 9 3 5, round the ii-V-I"
