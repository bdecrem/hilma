    {
      "after": 2,
      "title": "Turning over",
      "skill": "Each inversion broken, climbing an octave",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-inv",
      "theme": {
        "glyph": "steps:4",
        "title": "The climb",
        "line": "Broken inversions are how a left hand climbs without jumping."
      }
    },
    {
      "after": 3,
      "title": "Loop with a bump",
      "skill": "The chord on 1, root and fifth on 3",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-loop",
      "theme": {
        "glyph": "bars:13",
        "title": "Two a bar",
        "line": "A chord on the 1 and a bump on the 3 is the oldest left-hand pattern there is."
      }
    },
    {
      "after": 4,
      "title": "Moving less at 80",
      "skill": "The near shapes on 1 and 3, faster",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-lead",
      "theme": {
        "glyph": "tempo",
        "title": "Less motion, more speed",
        "line": "A hand that stays put can play twice as often. That's the point of inversions."
      }
    },
    {
      "after": 5,
      "title": "Chank with a push",
      "skill": "The and of 1, then 2 and 4",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-chank",
      "theme": {
        "glyph": "bars:24",
        "title": "The push",
        "line": "A chord just before the beat pulls the band along. Late eighth, then the backbeat."
      }
    },
    {
      "after": 6,
      "title": "Sus on the four",
      "skill": "Sus on 1, home on 2, sus again on 4",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-sus",
      "theme": {
        "glyph": "keys:145",
        "title": "Leaning into the bar",
        "line": "A sus on the 4 is a question the next bar answers."
      }
    },
    {
      "after": 7,
      "title": "Shell and five",
      "skill": "The shell on 1, the fifth alone on 3",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-shell",
      "theme": {
        "glyph": "bars:13",
        "title": "Two hands' worth",
        "line": "Chord on 1, bass note on 3: one hand doing a pianist's two."
      }
    },
    {
      "after": 8,
      "title": "Nine, broken",
      "skill": "The rootless shape, a note a beat",
      "goal": "Have fun. A clean chorus marks it played.",
      "step": "jam-m9",
      "theme": {
        "glyph": "walk",
        "title": "Ring the nine",
        "line": "The last note of the climb is the ninth. Over the bass it floats."
      }
    }
  ],
