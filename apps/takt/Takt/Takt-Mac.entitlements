<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac (Catalyst) only: the Mac App Store requires the sandbox. Takt plays audio (no input),
     reads MIDI through CoreMIDI (allowed in the sandbox), talks to ola.cx (network client) and
     saves exported loops where the player picks (user-selected files). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
